---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ProjectHUB — Plataforma de Colaboración Académica</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #FAFAFA;
        color: #1A1A1A;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Acento institucional -->
    <div class="h-1.5 bg-[#527630] w-full"></div>

    <!-- Navegación -->
    <header class="border-b border-[#B4B4B4] bg-white py-4 px-8">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-3">
          <a href="/" class="flex flex-col no-underline text-inherit hover:text-[#527630]">
            <span class="font-mono text-[9px] uppercase tracking-wider font-bold text-[#527630]">Universidad de Colima</span>
            <span class="text-xl font-bold tracking-tight">Project<span class="text-[#006096]">HUB</span></span>
          </a>
        </div>
        <a href="/" class="text-xs font-mono border border-[#B4B4B4] px-3 py-1.5 rounded-sm hover:bg-[#F5F5F5] transition-all no-underline text-[#4E4D4D] font-bold">
          &larr; Volver al StudentHUB
        </a>
      </div>
    </header>

    <!-- Contenido -->
    <main class="flex-grow flex items-center justify-center p-6">
      <div class="max-w-2xl w-full bg-white border border-[#B4B4B4] p-8 md:p-12 text-center space-y-6 rounded-sm">
        <span class="text-5xl block animate-bounce">🚀</span>
        
        <div class="space-y-2">
          <span class="font-mono text-[10px] uppercase tracking-widest font-bold text-[#527630] px-2.5 py-1 bg-[#F5F5F5] border border-[#B4B4B4] rounded-sm">
            Fase de Arquitectura / Próximo Módulo
          </span>
          <h1 class="text-3xl md:text-4xl font-bold tracking-tight mt-4">
            Plataforma de Proyectos y Colaboración
          </h1>
          <p class="text-xs text-[#4E4D4D] leading-relaxed max-w-md mx-auto mt-2">
            ProjectHUB será el punto de encuentro digital para la investigación. Conectará proyectos de investigadores, cuerpos académicos, financiamientos y tesis de estudiantes.
          </p>
        </div>

        <div class="divider-suizo border-t border-[#B4B4B4] my-6"></div>

        <!-- Características a Futuro -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
          <div class="p-4 border border-[#B4B4B4] rounded-sm">
            <span class="text-lg block mb-1">🔬</span>
            <h3 class="font-bold text-xs">Líneas de Investigación</h3>
            <p class="text-[10px] text-[#4E4D4D] mt-1 leading-snug">Visualización de proyectos financiados y patentes activas.</p>
          </div>
          <div class="p-4 border border-[#B4B4B4] rounded-sm">
            <span class="text-lg block mb-1">🤝</span>
            <h3 class="font-bold text-xs">Bolsa de Tesis</h3>
            <p class="text-[10px] text-[#4E4D4D] mt-1 leading-snug">Espacio para que alumnos apliquen a tesis de investigadores.</p>
          </div>
          <div class="p-4 border border-[#B4B4B4] rounded-sm">
            <span class="text-lg block mb-1">📊</span>
            <h3 class="font-bold text-xs">Cuerpos Académicos</h3>
            <p class="text-[10px] text-[#4E4D4D] mt-1 leading-snug">Indicadores de consolidación del claustro de investigación.</p>
          </div>
        </div>

        <div class="pt-6">
          <a href="/" class="inline-block bg-[#006096] text-white text-[10px] font-mono font-bold uppercase tracking-wider px-6 py-3 rounded-sm hover:bg-opacity-90 transition-all no-underline">
            Ir al Horario de Clases (StudentHUB)
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#B4B4B4] py-6 text-center bg-[#F5F5F5] text-xs font-mono text-[#4E4D4D]">
      <span>Universidad de Colima &bull; ProjectHUB en Desarrollo</span>
    </footer>
  </body>
</html>

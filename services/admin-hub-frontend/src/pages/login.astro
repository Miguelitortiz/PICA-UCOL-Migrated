---
// login.astro — Página de autenticación del AdminHUB
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Acceso al Panel de Administración Académica"
    />
    <title>Iniciar Sesión — AdminHUB</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --primary: #527630;
        --primary-dark: #3d5923;
        --primary-light: #6a9940;
        --secondary: #006096;
        --bg: #f5f4f0;
        --bg-card: #ffffff;
        --text: #1a1a1a;
        --text-sub: #4e4d4d;
        --border: #b4b4b4;
        --border-focus: #527630;
        --error: #990000;
        --error-bg: #fff5f5;
        --success: #527630;
        --font: "Inter", system-ui, sans-serif;
        --mono: "JetBrains Mono", monospace;
      }

      body {
        font-family: var(--font);
        background-color: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      /* Banda institucional */
      .top-bar {
        height: 4px;
        background: linear-gradient(
          90deg,
          var(--primary) 0%,
          var(--primary-light) 50%,
          var(--secondary) 100%
        );
        width: 100%;
        flex-shrink: 0;
      }

      .login-wrapper {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        min-height: calc(100vh - 4px);
      }

      .login-container {
        width: 100%;
        max-width: 440px;
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      /* Logo / Header */
      .login-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .logo-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--primary);
        color: white;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        padding: 0.35rem 0.75rem;
        border-radius: 2px;
        margin-bottom: 1.25rem;
      }

      .login-header h1 {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.025em;
        line-height: 1.1;
        margin-bottom: 0.375rem;
      }

      .login-header p {
        font-size: 0.8125rem;
        color: var(--text-sub);
        font-family: var(--mono);
      }

      /* Card del formulario */
      .login-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
        box-shadow:
          0 2px 16px rgba(0, 0, 0, 0.07),
          0 1px 4px rgba(0, 0, 0, 0.04);
      }

      .card-header {
        background: #f9f9f7;
        border-bottom: 1px solid var(--border);
        padding: 0.875rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .card-header-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--primary);
      }

      .card-header span {
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-sub);
      }

      .card-body {
        padding: 2rem 1.5rem;
      }

      /* Form */
      .form-group {
        margin-bottom: 1.125rem;
      }

      .form-label {
        display: block;
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-sub);
        margin-bottom: 0.375rem;
      }

      .form-input {
        width: 100%;
        height: 44px;
        padding: 0 0.875rem;
        border: 1px solid var(--border);
        border-radius: 2px;
        font-family: var(--font);
        font-size: 0.875rem;
        color: var(--text);
        background: white;
        transition:
          border-color 150ms ease,
          box-shadow 150ms ease;
        outline: none;
        -webkit-appearance: none;
      }

      .form-input:focus {
        border-color: var(--border-focus);
        box-shadow: 0 0 0 3px rgba(82, 118, 48, 0.12);
      }

      .form-input.error {
        border-color: var(--error);
        box-shadow: 0 0 0 3px rgba(153, 0, 0, 0.08);
      }

      .form-input::placeholder {
        color: #bbbbbb;
        font-size: 0.8125rem;
      }

      /* Password toggle */
      .input-wrapper {
        position: relative;
      }

      .input-wrapper .form-input {
        padding-right: 2.75rem;
      }

      .pass-toggle {
        position: absolute;
        right: 0.625rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-sub);
        font-size: 1rem;
        padding: 0.25rem;
        line-height: 1;
        transition: color 150ms;
      }

      .pass-toggle:hover {
        color: var(--primary);
      }

      /* Error message */
      .error-msg {
        display: none;
        align-items: center;
        gap: 0.5rem;
        background: var(--error-bg);
        border: 1px solid rgba(153, 0, 0, 0.2);
        border-radius: 2px;
        padding: 0.625rem 0.875rem;
        margin-bottom: 1.125rem;
        font-size: 0.8rem;
        color: var(--error);
        font-family: var(--mono);
      }

      .error-msg.visible {
        display: flex;
      }

      /* Submit button */
      .btn-login {
        width: 100%;
        height: 44px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 2px;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          background 150ms ease,
          transform 100ms ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.375rem;
      }

      .btn-login:hover:not(:disabled) {
        background: var(--primary-dark);
      }
      .btn-login:active:not(:disabled) {
        transform: scale(0.99);
      }
      .btn-login:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      /* Loader en botón */
      .btn-loader {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: none;
      }

      .btn-login.loading .btn-loader {
        display: block;
      }
      .btn-login.loading .btn-text {
        display: none;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      /* Shake animation */
      @keyframes shake {
        0%,
        100% {
          transform: translateX(0);
        }
        20% {
          transform: translateX(-8px);
        }
        40% {
          transform: translateX(8px);
        }
        60% {
          transform: translateX(-5px);
        }
        80% {
          transform: translateX(5px);
        }
      }

      .shake {
        animation: shake 0.4s ease;
      }

      /* Divider */
      .divider {
        height: 1px;
        background: var(--border);
        margin: 1.5rem 0;
      }

      /* Demo credentials table */
      .demo-section {
        padding: 1rem 1.5rem 1.25rem;
        background: #f9f9f7;
        border-top: 1px solid var(--border);
      }

      .demo-label {
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-sub);
        margin-bottom: 0.625rem;
        display: block;
      }

      .demo-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.375rem;
      }

      .demo-item {
        background: white;
        border: 1px solid var(--border);
        border-radius: 2px;
        padding: 0.375rem 0.5rem;
        cursor: pointer;
        transition:
          border-color 150ms,
          background 150ms;
        text-align: left;
      }

      .demo-item:hover {
        border-color: var(--primary);
        background: rgba(82, 118, 48, 0.04);
      }

      .demo-item-role {
        font-size: 9px;
        font-family: var(--mono);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--primary);
        letter-spacing: 0.06em;
        margin-bottom: 2px;
      }

      .demo-item-user {
        font-size: 11px;
        font-family: var(--mono);
        color: var(--text);
        font-weight: 500;
      }

      /* Footer */
      .login-footer {
        text-align: center;
        margin-top: 1.25rem;
        font-family: var(--mono);
        font-size: 10px;
        color: var(--text-sub);
        opacity: 0.7;
      }

      /* Focus visible accessibility */
      :focus-visible {
        outline: 3px solid var(--secondary);
        outline-offset: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        * {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="top-bar"></div>

    <div class="login-wrapper">
      <div class="login-container">
        <!-- Header -->
        <div class="login-header">
          <div class="logo-badge">■ AdminHUB</div>
          <h1>Iniciar Sesión</h1>
          <p>Universidad de Colima · Panel de Administración Académica</p>
        </div>

        <!-- Card -->
        <div class="login-card">
          <div class="card-header">
            <div class="card-header-dot"></div>
            <span>Autenticación de Acceso</span>
          </div>

          <div class="card-body">
            <!-- Error message -->
            <div id="error-msg" class="error-msg" role="alert">
              <span>⚠</span>
              <span id="error-text">Credenciales incorrectas.</span>
            </div>

            <form id="login-form" novalidate>
              <div class="form-group">
                <label class="form-label" for="username"
                  >Usuario o Correo Institucional</label
                >
                <input
                  type="text"
                  id="username"
                  name="username"
                  class="form-input"
                  placeholder="Ej: cruiz  o  cruiz@ucol.mx"
                  autocomplete="username"
                  autocapitalize="none"
                  spellcheck="false"
                  required
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="password">Contraseña</label>
                <div class="input-wrapper">
                  <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-input"
                    placeholder="••••••••"
                    autocomplete="current-password"
                    required
                  />
                  <button
                    type="button"
                    class="pass-toggle"
                    id="pass-toggle"
                    aria-label="Mostrar contraseña"
                  >
                    👁
                  </button>
                </div>
              </div>

              <button type="submit" class="btn-login" id="btn-login">
                <div class="btn-loader"></div>
                <span class="btn-text">Ingresar al Panel</span>
              </button>
            </form>
          </div>

          <!-- Demo credentials -->
          <div class="demo-section">
            <span class="demo-label"
              >🔑 Accesos de prueba (contraseña: prueba123, admin: admin_pass)</span
            >
            <div class="demo-grid" id="demo-grid">
              <button
                class="demo-item"
                data-user="carlos.navarro_2@ucol.mx"
                data-role="Docente"
              >
                <div class="demo-item-role">Docente</div>
                <div class="demo-item-user">carlos.navarro_2</div>
              </button>
              <button
                class="demo-item"
                data-user="ana.pérez_6@ucol.mx"
                data-role="Docente"
              >
                <div class="demo-item-role">Docente</div>
                <div class="demo-item-user">ana.pérez_6</div>
              </button>
              <button
                class="demo-item"
                data-user="jefe.computacio"
                data-role="Jefe de Carrera"
              >
                <div class="demo-item-role">Jefe de Carrera</div>
                <div class="demo-item-user">jefe.computacio</div>
              </button>
              <button
                class="demo-item"
                data-user="coord.fime"
                data-role="Coordinador FIME"
              >
                <div class="demo-item-role">Coordinador</div>
                <div class="demo-item-user">coord.fime</div>
              </button>
              <button
                class="demo-item"
                data-user="admin.dir"
                data-role="Admin Dirección"
              >
                <div class="demo-item-role">Admin Dirección</div>
                <div class="demo-item-user">admin.dir</div>
              </button>
              <button
                class="demo-item"
                data-user="admin"
                data-role="Admin General"
              >
                <div class="demo-item-role">Admin General</div>
                <div class="demo-item-user">admin (admin_pass)</div>
              </button>
            </div>
          </div>
        </div>

        <p class="login-footer">
          AdminHUB· Plataforma Académica Integrada · Universidad de Colima
        </p>
      </div>
    </div>

    <script>
      // Redirigir si ya hay sesión activa
      const existingToken = localStorage.getItem("pica_jwt");
      if (existingToken) {
        // Verificar que el token no haya expirado
        try {
          const payload = JSON.parse(atob(existingToken.split(".")[1]));
          if (payload.exp * 1000 > Date.now()) {
            window.location.href = "/admin";
          } else {
            localStorage.removeItem("pica_jwt");
            localStorage.removeItem("pica_user");
          }
        } catch {
          localStorage.removeItem("pica_jwt");
          localStorage.removeItem("pica_user");
        }
      }

      const form = document.getElementById("login-form");
      const btnLogin = document.getElementById("btn-login");
      const errorMsg = document.getElementById("error-msg");
      const errorText = document.getElementById("error-text");
      const usernameInput = document.getElementById("username");
      const passwordInput = document.getElementById("password");
      const passToggle = document.getElementById("pass-toggle");
      const demoGrid = document.getElementById("demo-grid");

      // Toggle contraseña
      passToggle?.addEventListener("click", () => {
        const isPassword = passwordInput.type === "password";
        passwordInput.type = isPassword ? "text" : "password";
        passToggle.textContent = isPassword ? "🙈" : "👁";
      });

      // Click en tarjetas de demo
      demoGrid?.querySelectorAll(".demo-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          const username = btn.getAttribute("data-user") || "";
          usernameInput.value = username;
          passwordInput.value =
            username === "admin" ? "admin_pass" : "prueba123";
          usernameInput.classList.remove("error");
          passwordInput.classList.remove("error");
          errorMsg.classList.remove("visible");
          usernameInput.focus();
        });
      });

      // Mostrar error con animación
      function showError(msg) {
        errorText.textContent = msg;
        errorMsg.classList.add("visible");
        usernameInput.classList.add("error");
        passwordInput.classList.add("error");

        const card = document.querySelector(".login-card");
        card.classList.remove("shake");
        void card.offsetWidth; // Reflow para reiniciar animación
        card.classList.add("shake");
      }

      // Limpiar error
      [usernameInput, passwordInput].forEach((input) => {
        input?.addEventListener("input", () => {
          input.classList.remove("error");
          if (
            !usernameInput.classList.contains("error") &&
            !passwordInput.classList.contains("error")
          ) {
            errorMsg.classList.remove("visible");
          }
        });
      });

      // Submit del formulario
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const username = usernameInput.value.trim();
        const password = passwordInput.value;

        if (!username || !password) {
          showError("Por favor ingresa tu usuario y contraseña.");
          return;
        }

        // Estado de carga
        btnLogin.disabled = true;
        btnLogin.classList.add("loading");

        try {
          const res = await fetch("/auth/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username, password }),
          });

          const data = await res.json();

          if (!res.ok) {
            showError(data.error || "Credenciales incorrectas.");
            return;
          }

          // Guardar token y datos de usuario
          localStorage.setItem("pica_jwt", data.token);
          localStorage.setItem("pica_user", JSON.stringify(data.user));

          // Redirigir al panel principal
          window.location.href = "/admin";
        } catch (err) {
          showError(
            "Error de conexión. Verifica que el servidor esté disponible.",
          );
        } finally {
          btnLogin.disabled = false;
          btnLogin.classList.remove("loading");
        }
      });
    </script>
  </body>
</html>

    <script>
      // =========================================================================
      // TIPOS Y CONSTANTES
      // =========================================================================
      const ROLE_LABELS: Record<string, string> = {
        docente: "Docente",
        jefe_carrera: "Jefe de Carrera",
        coordinador_facultad: "Coordinador de Facultad",
        admin_direccion: "Administrador de Dirección",
        admin_general: "Administrador General",
      };

      const ROLE_COLORS: Record<string, string> = {
        docente: "#527630",
        jefe_carrera: "#006096",
        coordinador_facultad: "#006096",
        admin_direccion: "#774B1E",
        admin_general: "#990000",
      };

      const ADMIN_ROLES = [
        "jefe_carrera",
        "coordinador_facultad",
        "admin_direccion",
        "admin_general",
      ];

      // =========================================================================
      // AUTH HELPER — Lee JWT del localStorage
      // =========================================================================
      function getAuthHeader(): string {
        const token = localStorage.getItem("pica_jwt");
        return token ? `Bearer ${token}` : "";
      }

      function getCurrentUser(): any {
        try {
          return JSON.parse(localStorage.getItem("pica_user") || "null");
        } catch {
          return null;
        }
      }

      async function apiFetch(url: string, options: any = {}) {
        options.headers = {
          ...options.headers,
          Authorization: getAuthHeader(),
        };
        const res = await fetch(url, options);
        if (res.status === 401) {
          localStorage.removeItem("pica_jwt");
          localStorage.removeItem("pica_user");
          window.location.href = "/admin/login";
        }
        return res;
      }

      // =========================================================================
      // ESTADO GLOBAL
      // =========================================================================
      let currentUser: any = null;
      let professorsList: any[] = [];
      let groupsList: any[] = [];
      let careersList: any[] = [];
      let schedulesList: any[] = [];
      let examsList: any[] = [];
      let myGroups: any[] = []; // Solo para docentes
      let syllabusList: any[] = [];

      // =========================================================================
      // INICIALIZACIÓN — Determinar rol y mostrar panel correcto
      // =========================================================================
      async function initPanel() {
        currentUser = getCurrentUser();
        if (!currentUser) return;

        // Mostrar indicador de rol
        const dot = document.getElementById("role-indicator-dot");
        const nameBadge = document.getElementById("role-active-name");
        const roleBadge = document.getElementById("role-active-label");

        if (dot)
          dot.style.backgroundColor =
            ROLE_COLORS[currentUser.role] || "#527630";
        if (nameBadge)
          nameBadge.textContent =
            currentUser.professor_name || currentUser.username || "Usuario";
        if (roleBadge)
          roleBadge.textContent =
            ROLE_LABELS[currentUser.role] || currentUser.role;

        const isDocente = currentUser.role === "docente";
        const isAdmin = ADMIN_ROLES.includes(currentUser.role);

        if (isDocente) {
          document.getElementById("panel-docente")?.classList.remove("hidden");
          await loadDocenteData();
        } else if (isAdmin) {
          document
            .getElementById("panel-administrativo")
            ?.classList.remove("hidden");
          await loadAllAdminData();
        }
      }

      // =========================================================================
      // CARGAR DATOS
      // =========================================================================
      function mapFormattedProfileToRaw(fmt: any) {
        if (!fmt) return null;

        // 1. Datos Personales y Laborales
        const professorData = {
          fullName: fmt.fullName || "",
          photoUrl: fmt.photoUrl || "",
          contactInfo: {
            phone: fmt.contactInfo?.phone || "",
            office: fmt.contactInfo?.office || "",
            officeHours: fmt.contactInfo?.officeHours || "",
            institutionalEmail:
              fmt.institutionalEmail || fmt.contactInfo?.institutionalEmail || "",
            nativeLanguage: fmt.contactInfo?.nativeLanguage || "",
            additionalEmail: fmt.contactInfo?.additionalEmail || "",
            homeAddress: fmt.contactInfo?.homeAddress || "",
          },
          laborData: {
            currentAppointment: fmt.title || "",
            academicUnit: fmt.department || "",
            admissionDate: fmt.admissionYear ? String(fmt.admissionYear) : "",
            employeeNumber: fmt.laborData?.employeeNumber || "",
            researchLines: fmt.laborData?.researchLines || [],
            academicBody: fmt.academicBody || {},
          },
        };

        // 2. Formación Académica
        const degrees: any[] = [];
        if (fmt.academicFormation?.licenciatura) {
          const lic = fmt.academicFormation.licenciatura;
          degrees.push({
            level: "Licenciatura",
            title: lic.degree || "",
            institution: lic.institution || "",
            graduationDate: lic.year ? String(lic.year) : "",
          });
        }
        if (Array.isArray(fmt.academicFormation?.maestrias)) {
          fmt.academicFormation.maestrias.forEach((mae: any) => {
            degrees.push({
              level: "Maestría",
              title: mae.degree || "",
              institution: mae.institution || "",
              graduationDate: mae.year ? String(mae.year) : "",
            });
          });
        }
        if (Array.isArray(fmt.academicFormation?.doctorados)) {
          fmt.academicFormation.doctorados.forEach((doc: any) => {
            degrees.push({
              level: "Doctorado",
              title: doc.degree || "",
              institution: doc.institution || "",
              graduationDate: doc.year ? String(doc.year) : "",
            });
          });
        }

        const certifications: any[] = [];
        if (Array.isArray(fmt.certifications)) {
          fmt.certifications.forEach((c: any) => {
            certifications.push({
              title: c.title || "",
              institution: c.institution || "",
              year: c.year ? Number(c.year) : null,
            });
          });
        }

        const academicFormation = { degrees, certifications };

        // 3. Producción Científica
        const scientificProduction: any[] = [];
        if (
          fmt.scientificProduction?.articles &&
          Array.isArray(fmt.scientificProduction.articles)
        ) {
          fmt.scientificProduction.articles.forEach((art: any) => {
            scientificProduction.push({
              type: "Artículo Científico",
              title: art.title || "",
              journalName: art.journal || "",
              year: art.year ? Number(art.year) : null,
              impactFactor: art.impactFactor || "",
              doiOrUrl: art.doi || "",
            });
          });
        }
        if (
          fmt.scientificProduction?.books &&
          Array.isArray(fmt.scientificProduction.books)
        ) {
          fmt.scientificProduction.books.forEach((bk: any) => {
            scientificProduction.push({
              type: "Libro",
              title: bk.title || "",
              role: bk.role || "",
              editorial: bk.editorial || "",
              year: bk.year ? Number(bk.year) : null,
            });
          });
        }

        // 4. Materiales Didácticos
        const educationalMaterials: any[] = [];
        if (Array.isArray(fmt.educationalMaterials)) {
          fmt.educationalMaterials.forEach((mat: any) => {
            educationalMaterials.push({
              title: mat.title || "",
              resourceType: mat.type || "",
              year: mat.year ? Number(mat.year) : null,
              accessUrl: mat.url || "",
            });
          });
        }

        // 5. Recursos Humanos (Tesis y Docencia)
        const thesisDirections: any[] = [];
        if (fmt.teaching?.theses && Array.isArray(fmt.teaching.theses)) {
          fmt.teaching.theses.forEach((th: any) => {
            thesisDirections.push({
              studentName: th.student || "",
              thesisTitle: th.title || "",
              endDate: th.year ? String(th.year) : "",
              role: th.role || "Asesor",
            });
          });
        }

        const teaching: any[] = [];
        if (fmt.teaching?.courses && Array.isArray(fmt.teaching.courses)) {
          fmt.teaching.courses.forEach((c: any) => {
            teaching.push({
              courseName: c.name || "",
              level: c.level || "Licenciatura",
              students: c.students ? Number(c.students) : 25,
              period: c.period || "",
            });
          });
        }

        const humanResources = {
          thesisDirections,
          teaching,
          examSynods: fmt.humanResources?.examSynods || [],
        };

        return {
          professorData,
          academicFormation,
          scientificProduction,
          educationalMaterials,
          humanResources,
        };
      }

      async function loadDocenteData() {
        try {
          const [carRes, grpRes, myGrpRes, schedRes, sylRes, profRes] =
            await Promise.all([
              apiFetch("/api/reference/careers"),
              apiFetch("/api/groups"),
              currentUser.professor_id
                ? apiFetch("/api/professors/me/groups")
                : Promise.resolve(null),
              apiFetch("/api/schedules"),
              apiFetch("/api/syllabus"),
              apiFetch("/api/professors"),
            ]);

          if (carRes.ok) careersList = await carRes.json();
          if (grpRes.ok) groupsList = await grpRes.json();
          if (myGrpRes && myGrpRes.ok) myGroups = await myGrpRes.json();
          if (schedRes.ok) schedulesList = await schedRes.json();
          if (sylRes.ok) syllabusList = await sylRes.json();

          if (profRes.ok) {
            professorsList = await profRes.json();
            const myProf = professorsList.find(
              (p) => String(p.id) === String(currentUser.professor_id)
            );
            if (myProf && myProf.profile_data) {
              originalCVData = mapFormattedProfileToRaw(myProf.profile_data);
              currentCVData = JSON.parse(JSON.stringify(originalCVData));
            }
          }

          populateDocenteSelectors();
          renderMyGroups();
          initializeCVEditorForm();
        } catch (err) {
          console.error("Error al cargar datos del docente:", err);
        }
      }

      function initializeCVEditorForm() {
        if (!currentCVData) {
          currentCVData = {
            professorData: {
              fullName: currentUser?.professor_name || "",
              contactInfo: {},
              laborData: {}
            },
            academicFormation: {
              degrees: [],
              certifications: []
            },

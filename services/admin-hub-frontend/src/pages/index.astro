            <!-- Lista de grupos con tutores actuales -->
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Tutores Actuales por Grupo</h3>
              <div id="tutor-groups-list" class="space-y-2">
                <p class="text-xs text-text-secondary italic">Cargando grupos...</p>
              </div>
            </div>
          </div>

          <!-- SUBTAB 3: EXAMEN MANAGER -->
          <div id="admin-tab-exams-mgr" class="admin-tab-panel hidden space-y-6">
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Programar Examen / Evaluación</h3>
              
              <form id="form-admin-exams" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Grupo</label>
                    <select id="exam-group" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <!-- Cargado dinámicamente -->
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Materia</label>
                    <input id="exam-subject" type="text" placeholder="Ej: Desarrollo Web Integrativo" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Fase / Examen</label>
                    <select id="exam-phase" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <option value="1° Parcial">1° Parcial</option>
                      <option value="2° Parcial">2° Parcial</option>
                      <option value="3° Parcial">3° Parcial</option>
                      <option value="Ordinario">Examen Ordinario</option>
                      <option value="Extraordinario">Examen Extraordinario</option>
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Fecha</label>
                    <input id="exam-date" type="date" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Hora</label>
                    <input id="exam-time" type="time" value="09:00" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                </div>

                <div class="pt-4 border-t border-bg-piedra flex justify-end">
                  <button type="submit" class="px-6 bg-primary text-white text-xs font-mono font-bold uppercase rounded-sm hover:bg-opacity-90 transition-suiza cursor-pointer h-11 flex items-center justify-center">
                    Programar Fecha de Examen
                  </button>
                </div>
              </form>
            </div>

            <!-- Listado de Exámenes Existentes -->
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Exámenes Programados en el Sistema</h3>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="border-b border-border-sutil bg-bg-piedra">
                      <th class="p-2 font-mono text-[9px] uppercase">Grupo</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Materia</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Examen</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Fecha</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Hora</th>
                      <th class="p-2 font-mono text-[9px] uppercase text-right">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="table-exams-list">
                    <!-- Cargados dinámicamente -->
                  </tbody>
                </table>
              </div>

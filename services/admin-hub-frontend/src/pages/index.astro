          uploadContainer.classList.add("border-primary");
        });

        uploadContainer.addEventListener("dragleave", () => {
          uploadContainer.classList.remove("border-primary");
        });

        uploadContainer.addEventListener("drop", (e) => {
          e.preventDefault();
          uploadContainer.classList.remove("border-primary");
          const files = e.dataTransfer?.files;
          if (files && files.length > 0) {
            handleCVFile(files[0]);
          }
        });
      }

      pdfInput?.addEventListener("change", async () => {
        const file = pdfInput.files?.[0];
        if (!file) return;
        handleCVFile(file);
      });

      async function handleCVFile(file: File) {
        if (file.type !== "application/pdf") {
          alert("Por favor, selecciona un archivo en formato PDF.");
          return;
        }

        uploadContainer?.classList.add("hidden");
        loadingContainer?.classList.remove("hidden");

        try {
          if (referenceDelegations.length === 0) {
            await loadReferenceData();
          }

          const formData = new FormData();
          formData.append("pdf", file);

          const res = await apiFetch("/api/extract", {
            method: "POST",
            body: formData,
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || "Fallo en la extracción");
          }

          currentCVData = await res.json();

          delegationId = referenceDelegations[0]?.id || null;
          adscriptionFacultyId = null;
          groupAssignments = [];

          const dpt = currentCVData.professorData?.laborData?.academicUnit;
          if (dpt && referenceFaculties.length > 0) {
            const bestMatch = findBestFacultyMatch(dpt, referenceFaculties);
            if (bestMatch) {
              adscriptionFacultyId = bestMatch.id;
              delegationId = bestMatch.delegation_id;
              if (!currentCVData.professorData.laborData) {
                currentCVData.professorData.laborData = {};
              }
              currentCVData.professorData.laborData.academicUnit =
                bestMatch.name;
            }
          }

          loadingContainer?.classList.add("hidden");
          uploadContainer?.classList.remove("hidden");

          if (cvDocName)
            cvDocName.textContent =
              currentCVData.professorData?.fullName || "Docente";
          if (editorSummaryTitle) {
            editorSummaryTitle.textContent = `${currentCVData.professorData?.laborData?.currentAppointment || "Docente"} — ${currentCVData.professorData?.laborData?.academicUnit || "Facultad"}`;
          }

          activeTab = "personales";
          updateTabButtons();
          renderActiveTab();
        } catch (e: any) {
          loadingContainer?.classList.add("hidden");
          uploadContainer?.classList.remove("hidden");
          errorContainer?.classList.remove("hidden");
          const errorMsg = document.getElementById("error-message");
          if (errorMsg) errorMsg.textContent = e.message;
        }
      }


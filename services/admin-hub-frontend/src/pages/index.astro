        });

        // Grupos
        const grpSelectors = [
          "lab-group",
          "sched-group",
          "tutor-group",
          "exam-group",
        ];
        grpSelectors.forEach((id) => {
          const sel = document.getElementById(id) as HTMLSelectElement;
          if (sel) {
            sel.innerHTML = "";
            groupsList.forEach((g) => {
              const opt = document.createElement("option");

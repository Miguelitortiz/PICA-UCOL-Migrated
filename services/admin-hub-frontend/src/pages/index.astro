          }

          html = `
          <div class="space-y-6 max-h-[600px] overflow-y-auto scrollbar-academic pr-2">
            <div>
              <div class="flex justify-between items-center mb-3">
                <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary flex items-center">
                  <span class="text-primary mr-2">§</span> Recursos y Materiales Didácticos
                </h4>
                <button onclick="window.addArrayItem('educationalMaterials')" class="px-3 py-1 border border-primary text-primary text-[10px] font-mono rounded-sm hover:bg-primary hover:text-white transition-suiza cursor-pointer">+ Agregar Material</button>
              </div>
              ${matsHtml}
            </div>
          </div>
        `;
          editorPanelContent.innerHTML = html;
        } else if (activeTab === "docencia") {
          const hr = currentCVData.humanResources || {
            teaching: [],
            theses: [],
          };

          let coursesHtml = "";
          if (hr.teaching && hr.teaching.length > 0) {
            hr.teaching.forEach((course: any, idx: number) => {
              coursesHtml += `
              <div class="p-3 border border-border-sutil rounded-sm bg-white mb-3 relative text-xs">
                <button onclick="window.removeArrayItem('humanResources.teaching', ${idx})" class="absolute top-2 right-2 text-text-secondary hover:text-primary font-mono text-[10px] cursor-pointer">✕</button>
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                  <div class="sm:col-span-2">
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Nombre de la Materia</label>
                    <input type="text" value="${course.courseName || ""}" oninput="window.updateField('humanResources.teaching.${idx}.courseName', this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Período / Año</label>
                    <input type="text" value="${course.period || ""}" oninput="window.updateField('humanResources.teaching.${idx}.period', this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" placeholder="Ago-Ene 2025" />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Alumnos</label>
                    <input type="number" value="${course.students || 20}" oninput="window.updateField('humanResources.teaching.${idx}.students', this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" />
                  </div>
                </div>
              </div>
            `;
            });
          } else {
            coursesHtml =
              '<p class="text-xs italic text-text-secondary mb-4">No se registraron cursos dictados.</p>';
          }

          let thesesHtml = "";
          if (hr.theses && hr.theses.length > 0) {
            hr.theses.forEach((thesis: any, idx: number) => {
              thesesHtml += `
              <div class="p-3 border border-border-sutil rounded-sm bg-white mb-3 relative text-xs">
                <button onclick="window.removeArrayItem('humanResources.theses', ${idx})" class="absolute top-2 right-2 text-text-secondary hover:text-primary font-mono text-[10px] cursor-pointer">✕</button>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div class="sm:col-span-3">
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Título de la Tesis</label>
                    <input type="text" value="${thesis.thesisTitle || ""}" oninput="window.updateField('humanResources.theses.${idx}.thesisTitle', this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" />
                  </div>
                  <div class="sm:col-span-2">
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Estudiante</label>
                    <input type="text" value="${thesis.studentName || ""}" oninput="window.updateField('humanResources.theses.${idx}.studentName', this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Rol</label>
                    <input type="text" value="${thesis.role || "Asesor"}" oninput="window.updateField('humanResources.theses.${idx}.role', this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" placeholder="Asesor o Coasesor" />
                  </div>
                </div>
              </div>
            `;
            });
          } else {
            thesesHtml =
              '<p class="text-xs italic text-text-secondary mb-4">No se registraron direcciones de tesis.</p>';
          }

          html = `
          <div class="space-y-6 max-h-[600px] overflow-y-auto scrollbar-academic pr-2">
            <div>
              <div class="flex justify-between items-center mb-3">
                <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary flex items-center">
                  <span class="text-primary mr-2">§</span> Docencia (Cursos Impartidos)
                </h4>
                <button onclick="window.addArrayItem('humanResources.teaching')" class="px-3 py-1 border border-primary text-primary text-[10px] font-mono rounded-sm hover:bg-primary hover:text-white transition-suiza cursor-pointer">+ Agregar Curso</button>
              </div>
              ${coursesHtml}
            </div>
            <div class="divider-suizo"></div>
            <div>
              <div class="flex justify-between items-center mb-3">
                <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary flex items-center">
                  <span class="text-primary mr-2">§</span> Dirección de Tesis y Proyectos
                </h4>
                <button onclick="window.addArrayItem('humanResources.theses')" class="px-3 py-1 border border-primary text-primary text-[10px] font-mono rounded-sm hover:bg-primary hover:text-white transition-suiza cursor-pointer">+ Agregar Tesis</button>
              </div>
              ${thesesHtml}
            </div>
          </div>
        `;
          editorPanelContent.innerHTML = html;
        } else if (activeTab === "grupos") {
          let delegationsOptions = "";
          referenceDelegations.forEach((d: any) => {
            delegationsOptions += `<option value="${d.id}" ${delegationId === d.id ? "selected" : ""}>${d.name}</option>`;
          });

          let facultiesOptions =
            '<option value="">Seleccione una facultad...</option>';
          referenceFaculties.forEach((f: any) => {
            facultiesOptions += `<option value="${f.id}" data-delegation="${f.delegation_id}">${f.name}</option>`;
          });

          let careersOptions =
            '<option value="">Seleccione una carrera...</option>';
          referenceCareers.forEach((c: any) => {
            careersOptions += `<option value="${c.id}" data-delegation="${c.delegation_id}">${c.name}</option>`;
          });

          const facultyCareerMap = Object.fromEntries(
            referenceFaculties.map((f: any) => [f.id, f.career_ids || []]),
          );

          let assignmentsListHtml = "";
          if (groupAssignments.length > 0) {
            groupAssignments.forEach((a: any, idx: number) => {
              assignmentsListHtml += `
              <div class="flex items-center justify-between p-3 border border-border-sutil rounded-sm bg-white text-xs">
                <div>
                  <span class="font-bold text-text-primary">${a.name}</span>
                  <span class="text-text-secondary ml-2 font-mono">— Clase: ${a.subject_taught || "No especificada"}</span>
                </div>
                <button type="button" onclick="window.removeGroupAssignment(${idx})" class="text-primary font-mono hover:underline cursor-pointer">Remover</button>
              </div>
            `;
            });
          } else {
            assignmentsListHtml =
              '<p class="text-xs italic text-text-secondary">No se han asignado grupos a este profesor todavía.</p>';
          }

          let adscriptionFacultiesOptions =
            '<option value="">No Especificada / Auto-detectar</option>';
          referenceFaculties.forEach((f: any) => {
            adscriptionFacultiesOptions += `<option value="${f.id}" data-delegation="${f.delegation_id}" ${adscriptionFacultyId == f.id ? "selected" : ""}>${f.name}</option>`;
          });

          html = `
          <div class="space-y-6 max-h-[600px] overflow-y-auto scrollbar-academic pr-2">
            <div>
              <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary mb-3 flex items-center">
                <span class="text-primary mr-2">§</span> Adscripción Institucional
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Facultad de Adscripción</label>
                  <select id="select-adscription-faculty" onchange="window.updateAdscriptionFaculty(this.value)" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none h-[34px]">
                    ${adscriptionFacultiesOptions}
                  </select>
                </div>
                <div>
                  <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Delegación</label>
                  <select id="select-delegation" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none h-[34px]" disabled>
                    ${delegationsOptions}
                  </select>
                </div>
              </div>
            </div>

            <div class="divider-suizo"></div>

            <div>
              <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary mb-3 flex items-center">
                <span class="text-primary mr-2">§</span> Asignación de Grupos Docentes
              </h4>
              
              <div class="bg-bg-piedra/20 p-4 border border-border-sutil rounded-sm mb-4 space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Facultad</label>
                    <select id="select-group-faculty" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none h-[34px]">
                      ${facultiesOptions}
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Carrera</label>
                    <select id="select-group-career" class="w-full text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none h-[34px]" disabled>
                      <option value="">Seleccione una carrera...</option>
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Grupo</label>
                    <div class="flex gap-2">
                      <select id="select-group" class="flex-grow text-xs font-sans bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none h-[34px]" disabled>
                        <option value="">Seleccione un grupo...</option>
                      </select>
                      <button type="button" id="btn-create-group-modal" class="px-3 bg-primary text-white text-xs font-mono rounded-sm hover:bg-opacity-90 font-bold cursor-pointer h-[34px]">
                        + Nuevo
                      </button>
                    </div>
                  </div>
                </div>

                <div>
                  <label class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary block mb-1">Materia Impartida</label>
                  <div class="flex gap-2 font-sans">
                    <input id="input-group-subject" type="text" placeholder="Ej: Procesamiento Digital de Señales" class="flex-grow text-xs bg-white border border-border-sutil rounded-sm p-2 text-text-primary focus:border-primary outline-none" />
                    <button type="button" id="btn-add-group-assignment" class="px-4 bg-primary text-white text-xs font-mono rounded-sm hover:bg-opacity-90 font-bold cursor-pointer h-[34px] flex items-center justify-center">
                      Asignar Grupo
                    </button>
                  </div>
                </div>
              </div>

              <!-- Lista de asignaciones actuales -->
              <div class="space-y-2" id="group-assignments-list">
                ${assignmentsListHtml}
              </div>
            </div>
          </div>
        `;

          const FACULTY_CAREER_MAP = facultyCareerMap;
          editorPanelContent.innerHTML = html;

          // Listeners cascada
          const selectDelegation = document.getElementById(
            "select-delegation",
          ) as HTMLSelectElement;
          const selectGrpFaculty = document.getElementById(
            "select-group-faculty",
          ) as HTMLSelectElement;
          const selectGrpCareer = document.getElementById(
            "select-group-career",
          ) as HTMLSelectElement;

          if (selectDelegation) {
            selectDelegation.addEventListener("change", () => {
              delegationId = selectDelegation.value
                ? parseInt(selectDelegation.value, 10)
                : null;
              const selectedDelId = selectDelegation.value;

              if (selectGrpFaculty) {
                Array.from(selectGrpFaculty.options).forEach((opt) => {
                  if (!opt.value) return;
                  opt.hidden = selectedDelId
                    ? opt.getAttribute("data-delegation") !== selectedDelId
                    : false;
                });
                selectGrpFaculty.value = "";
              }

              if (selectGrpCareer) {
                selectGrpCareer.innerHTML =
                  '<option value="">Seleccione una carrera...</option>';
                selectGrpCareer.disabled = true;
              }

              const selectGrp = document.getElementById(
                "select-group",
              ) as HTMLSelectElement;
              if (selectGrp) {
                selectGrp.innerHTML =
                  '<option value="">Seleccione un grupo...</option>';
                selectGrp.disabled = true;
              }
            });
          }

          if (selectGrpFaculty) {
            selectGrpFaculty.addEventListener("change", () => {
              const facId = selectGrpFaculty.value
                ? parseInt(selectGrpFaculty.value, 10)
                : null;
              if (selectGrpCareer) {
                selectGrpCareer.innerHTML =
                  '<option value="">Seleccione una carrera...</option>';
                if (facId && FACULTY_CAREER_MAP[facId]) {
                  const allowedCareerIds: number[] = FACULTY_CAREER_MAP[facId];
                  referenceCareers
                    .filter((c: any) => allowedCareerIds.includes(c.id))
                    .forEach((c: any) => {
                      const opt = document.createElement("option");
                      opt.value = String(c.id);
                      opt.textContent = c.name;
                      selectGrpCareer.appendChild(opt);
                    });
                  selectGrpCareer.disabled = false;
                } else {
                  selectGrpCareer.disabled = true;
                }
              }

              const selectGrp = document.getElementById(
                "select-group",
              ) as HTMLSelectElement;
              if (selectGrp) {
                selectGrp.innerHTML =
                  '<option value="">Seleccione un grupo...</option>';
                selectGrp.disabled = true;
              }
            });
          }

          if (selectGrpCareer) {
            selectGrpCareer.addEventListener("change", () => {
              const cid = selectGrpCareer.value
                ? parseInt(selectGrpCareer.value, 10)
                : null;
              if (cid) {
                loadGroupsForCareer(cid);
              } else {
                const selectGrp = document.getElementById(
                  "select-group",
                ) as HTMLSelectElement;
                if (selectGrp) {
                  selectGrp.innerHTML =
                    '<option value="">Seleccione un grupo...</option>';
                  selectGrp.disabled = true;
                }
              }
            });
          }

          const btnCreateGrp = document.getElementById(
            "btn-create-group-modal",
          );
          if (btnCreateGrp) {
            btnCreateGrp.addEventListener("click", openCreateGroupModal);
          }

          const btnAddAssignment = document.getElementById(
            "btn-add-group-assignment",
          );
          if (btnAddAssignment) {
            btnAddAssignment.addEventListener("click", () => {
              const selectGrp = document.getElementById(
                "select-group",
              ) as HTMLSelectElement;
              const inputSubj = document.getElementById(
                "input-group-subject",
              ) as HTMLInputElement;
              const groupId = selectGrp ? parseInt(selectGrp.value, 10) : null;
              const subject = inputSubj ? inputSubj.value.trim() : "";

              if (!groupId) {
                alert("Por favor, selecciona un grupo para asignar.");
                return;
              }

              const matchedGroup = currentGroups.find(
                (g: any) => g.id === groupId,
              );
              if (matchedGroup) {
                if (
                  groupAssignments.some((a) => a.class_group_id === groupId)
                ) {
                  alert("El profesor ya está asignado a este grupo.");
                  return;
                }

                groupAssignments.push({
                  class_group_id: groupId,
                  name: matchedGroup.name,
                  subject_taught: subject,
                });

                if (inputSubj) inputSubj.value = "";
                renderActiveTab();
              }
            });
          }
        }
      }

      // --- VINCULACIÓN GLOBAL DE MÉTODOS A WINDOW ---
      (window as any).updateField = (path: string, value: string) => {
        if (!currentCVData) return;

        const parts = path.split(".");
        let obj = currentCVData;

        for (let i = 0; i < parts.length - 1; i++) {
          const part = parts[i];
          if (!isNaN(Number(parts[i + 1]))) {
            obj = obj[part];
          } else {
            if (!obj[part]) obj[part] = {};
            obj = obj[part];
          }
        }

        const lastKey = parts[parts.length - 1];

        if (value === "") {
          obj[lastKey] = null;
        } else if (
          !isNaN(Number(value)) &&
          lastKey !== "phone" &&
          lastKey !== "professionalId" &&
          lastKey !== "isbn" &&
          lastKey !== "issn" &&
          lastKey !== "code" &&
          lastKey !== "endDate"
        ) {
          obj[lastKey] = value.includes(".")
            ? parseFloat(value)
            : parseInt(value);
        } else {
          obj[lastKey] = value;
        }

        if (path === "professorData.laborData.academicUnit") {
          const match = referenceFaculties.find((f: any) => f.name === value);
          if (match) {
            adscriptionFacultyId = match.id;
            delegationId = match.delegation_id;
          } else {
            adscriptionFacultyId = null;
          }
        }
      };

      (window as any).removeArrayItem = (path: string, index: number) => {
        if (
          !currentCVData ||
          !confirm("¿Estás seguro de que deseas eliminar este elemento?")
        )
          return;

        const parts = path.split(".");
        let obj = currentCVData;
        for (let i = 0; i < parts.length - 1; i++) {
          obj = obj[parts[i]];
        }

        const arr = obj[parts[parts.length - 1]];
        if (Array.isArray(arr)) {
          arr.splice(index, 1);
          renderActiveTab();
        }
      };

      (window as any).removeGroupAssignment = (index: number) => {
        groupAssignments.splice(index, 1);
        renderActiveTab();
      };

      (window as any).updateAdscriptionFaculty = (val: string) => {
        adscriptionFacultyId = val ? parseInt(val, 10) : null;

        if (currentCVData && currentCVData.professorData) {
          if (!currentCVData.professorData.laborData) {
            currentCVData.professorData.laborData = {};
          }
          if (adscriptionFacultyId) {
            const match = referenceFaculties.find(
              (f: any) => f.id === adscriptionFacultyId,
            );
            if (match) {
              currentCVData.professorData.laborData.academicUnit = match.name;
            }
          } else {
            currentCVData.professorData.laborData.academicUnit = "";
          }
        }

        const selectFac = document.getElementById(
          "select-adscription-faculty",
        ) as HTMLSelectElement;
        if (selectFac && selectFac.selectedIndex >= 0) {
          const del =
            selectFac.options[selectFac.selectedIndex].getAttribute(
              "data-delegation",
            );
          if (del) {
            delegationId = parseInt(del, 10);
            const selectDel = document.getElementById(
              "select-delegation",
            ) as HTMLSelectElement;
            if (selectDel) selectDel.value = String(delegationId);
          }
        }
      };

      (window as any).addArrayItem = (path: string, typeSpec?: string) => {
        if (!currentCVData) return;

        const parts = path.split(".");
        let obj = currentCVData;
        for (let i = 0; i < parts.length - 1; i++) {
          if (!obj[parts[i]]) obj[parts[i]] = {};
          obj = obj[parts[i]];
        }

        const key = parts[parts.length - 1];
        if (!obj[key]) obj[key] = [];

        const arr = obj[key];
        let newItem = {};

        if (path.endsWith("degrees")) {
          newItem = {
            level: "Licenciatura",
            title: "",
            institution: "",
            professionalId: "",
            startDate: new Date().getFullYear() - 4,
            endDate: new Date().getFullYear(),
            graduationDate: "grado",
          };
        } else if (path.endsWith("certifications")) {
          newItem = {
            title: "",
            institution: "",
            year: new Date().getFullYear(),
            hours: 20,
            profile: "Pedagógico",
            scope: "Institucional",
          };
        } else if (path.endsWith("scientificProduction")) {
          if (typeSpec === "Artículo Científico") {
            newItem = {
              type: "Artículo Científico",
              title: "",
              journalName: "",
              year: new Date().getFullYear(),
              impactFactor: null,
              doiOrUrl: "",
              authors: [currentCVData.professorData?.fullName || ""],
            };
          } else {
            newItem = {
              type: "Libro",
              title: "",
              role: "Coautor",
              editorial: "",
              year: new Date().getFullYear(),
              authors: [currentCVData.professorData?.fullName || ""],
            };
          }
        } else if (path.endsWith("educationalMaterials")) {
          newItem = {
            type: "Material Didáctico",
            resourceType: "Recurso digital",
            title: "",
            year: new Date().getFullYear(),
            accessUrl: "",
            description: "",
            authors: [currentCVData.professorData?.fullName || ""],
          };
        } else if (path.endsWith("teaching")) {
          newItem = {
            courseName: "",
            level: "Licenciatura",
            students: 25,
            period: "Ago-Ene",
            year: new Date().getFullYear(),
          };
        } else if (path.endsWith("theses")) {
          newItem = {
            studentName: "",
            thesisTitle: "",
            endDate: new Date().getFullYear(),
            role: "Asesor",
          };
        }

        arr.push(newItem);
        renderActiveTab();
      };

      // =========================================================================
      // ARRANQUE
      // =========================================================================
      initPanel();
    </script>
  </div>
</Layout>

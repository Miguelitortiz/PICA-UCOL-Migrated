      function populateDocenteSelectors() {
        // Criterios de evaluación dinámicos (definidos arriba para scope)
        const criteriaContainer = document.getElementById("criteria-items-container");
        const btnAddCriteria = document.getElementById("btn-add-criteria-item");
        const totalIndicator = document.getElementById("crit-total-indicator");

        const updatePctTotal = () => {
          const pctInputs = document.querySelectorAll(".crit-input-pct");
          let sum = 0;
          pctInputs.forEach((input) => {
            const val = parseInt((input as HTMLInputElement).value, 10) || 0;
            sum += val;
          });
          if (totalIndicator) {
            totalIndicator.textContent = `Suma: ${sum}%`;
            if (sum === 100) {
              totalIndicator.className =
                "font-mono text-xs font-bold text-primary bg-primary/10 px-2 py-0.5 border border-primary/20 rounded-sm";
            } else {
              totalIndicator.className =
                "font-mono text-xs font-bold text-error bg-error/10 px-2 py-0.5 border border-error/20 rounded-sm animate-pulse";
            }
          }
        };

        const createCriteriaRow = (desc = "", pct = "") => {
          if (!criteriaContainer) return;
          const row = document.createElement("div");
          row.className = "flex gap-2 items-center criteria-row";
          row.innerHTML = `
            <input
              type="text"
              placeholder="Descripción del parámetro (Ej: Exámenes Teóricos)"
              class="flex-grow border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold crit-desc-input text-text-primary"
              value="${desc}"
              required
            />
            <div class="w-24 relative">
              <input
                type="number"
                min="0"
                max="100"
                placeholder="Ej: 50"
                class="w-full border border-border-sutil rounded-sm pl-3 pr-6 outline-none focus:border-secondary font-bold h-11 crit-input-pct text-text-primary"
                value="${pct}"
                required
              />
              <span class="absolute right-3 top-3.5 font-mono text-[10px] text-text-secondary">%</span>
            </div>
            <button
              type="button"
              class="btn-delete-criteria px-3 h-11 bg-error/10 hover:bg-error/20 text-error font-mono text-[10px] uppercase font-bold border border-error/20 rounded-sm transition-suiza cursor-pointer"
            >
              Eliminar
            </button>
          `;
          
          row.querySelector(".crit-input-pct")?.addEventListener("input", updatePctTotal);
          row.querySelector(".btn-delete-criteria")?.addEventListener("click", () => {
            row.remove();
            updatePctTotal();
          });
          
          criteriaContainer.appendChild(row);
          updatePctTotal();
        };

        if (btnAddCriteria) {
          const newBtnAdd = btnAddCriteria.cloneNode(true);
          btnAddCriteria.parentNode?.replaceChild(newBtnAdd, btnAddCriteria);
          newBtnAdd.addEventListener("click", () => {
            createCriteriaRow();
          });
        }

        // Guardar la función en window para poder reconstruir después de resetear
        (window as any).rebuildDefaultCriteria = () => {
          if (criteriaContainer) criteriaContainer.innerHTML = "";
          createCriteriaRow("Exámenes", "50");
          createCriteriaRow("Proyecto Integrador", "30");
          createCriteriaRow("Tareas", "20");
        };

        // Materias asignadas para syllabus
        const sylSubject = document.getElementById(
          "syl-subject",
        ) as HTMLSelectElement;
        if (sylSubject) {
          sylSubject.innerHTML = "";

          // Obtener lista única de materias asignadas al docente
          const uniqueSubjects = [
            ...new Set(myGroups.map((g) => g.subject_taught).filter(Boolean)),
          ];

          if (uniqueSubjects.length === 0) {
            sylSubject.innerHTML =
              '<option value="">No tienes materias asignadas</option>';
          } else {
            uniqueSubjects.forEach((sub) => {
              const opt = document.createElement("option");
              opt.value = sub;
              opt.textContent = sub;
              sylSubject.appendChild(opt);
            });
          }
        }

        // Auto-llenar Carrera Destino basado en materia seleccionada + pre-llenar syllabus existente
        const updateSyllabusCareer = () => {
          if (!sylSubject) return;
          const selectedSub = sylSubject.value;
          const matchedGroup = myGroups.find((g) => g.subject_taught === selectedSub);
          const sylCareerNameInput = document.getElementById("syl-career-name") as HTMLInputElement;
          const sylCareerHiddenInput = document.getElementById("syl-career") as HTMLInputElement;
          
          if (matchedGroup && matchedGroup.career_id) {
            const matchedCareer = careersList.find((c) => c.id === matchedGroup.career_id);
            if (matchedCareer) {
              if (sylCareerNameInput) sylCareerNameInput.value = matchedCareer.name;
              if (sylCareerHiddenInput) sylCareerHiddenInput.value = String(matchedCareer.id);
            }
          } else {
            if (sylCareerNameInput) sylCareerNameInput.value = "";
            if (sylCareerHiddenInput) sylCareerHiddenInput.value = "";
          }

          // Pre-llenar datos del syllabus si ya existe
          const matchedSyllabus = syllabusList.find((s) => s.subject_name === selectedSub);
          const sylDescriptionInput = document.getElementById("syl-description") as HTMLTextAreaElement;
          const resTitleInput = document.getElementById("res-title-1") as HTMLInputElement;
          const resAuthorInput = document.getElementById("res-author-1") as HTMLInputElement;
          const resLinkInput = document.getElementById("res-link-1") as HTMLInputElement;

          if (matchedSyllabus) {
            if (sylDescriptionInput) sylDescriptionInput.value = matchedSyllabus.program_description || "";
            
            // Cargar recursos/bibliografía (Libro 1)
            const resources = matchedSyllabus.resources || [];
            if (resources.length > 0) {
              if (resTitleInput) resTitleInput.value = resources[0].title || "";
              if (resAuthorInput) resAuthorInput.value = resources[0].author || "";
              if (resLinkInput) resLinkInput.value = resources[0].link || "";
            } else {
              if (resTitleInput) resTitleInput.value = "";
              if (resAuthorInput) resAuthorInput.value = "";
              if (resLinkInput) resLinkInput.value = "";
            }

            // Cargar criterios de evaluación dinámicos
            if (criteriaContainer) {
              criteriaContainer.innerHTML = "";
              const criteria = matchedSyllabus.evaluation_criteria || {};
              const keys = Object.keys(criteria);
              if (keys.length > 0) {
                keys.forEach((key) => {
                  const pctVal = String(criteria[key]).replace("%", "");
                  createCriteriaRow(key, pctVal);
                });
              } else {
                createCriteriaRow("Exámenes", "50");
                createCriteriaRow("Proyecto Integrador", "30");
                createCriteriaRow("Tareas", "20");
              }
            }
          } else {
            // Limpiar o poner por defecto si no hay plan de estudio previo
            if (sylDescriptionInput) sylDescriptionInput.value = "";
            if (resTitleInput) resTitleInput.value = "";
            if (resAuthorInput) resAuthorInput.value = "";
            if (resLinkInput) resLinkInput.value = "";
            
            if (criteriaContainer) {
              criteriaContainer.innerHTML = "";
              createCriteriaRow("Exámenes", "50");
              createCriteriaRow("Proyecto Integrador", "30");
              createCriteriaRow("Tareas", "20");
            }
          }
        };

        if (sylSubject) {
          sylSubject.removeEventListener("change", updateSyllabusCareer);
          sylSubject.addEventListener("change", updateSyllabusCareer);
          updateSyllabusCareer();
        }

        // Sincronizar selectores de laboratorio (sólo permite materias y horarios oficiales del docente)
        const labScheduleSelect = document.getElementById(
          "lab-schedule-select",
        ) as HTMLSelectElement;
        if (labScheduleSelect) {
          labScheduleSelect.innerHTML = "";

          // Filtrar clases ordinarias asignadas a este docente
          const mySchedules = schedulesList.filter(
            (s) =>
              s.professor_id === currentUser?.professor_id &&
              s.is_laboratory === false,
          );

          if (mySchedules.length === 0) {
            labScheduleSelect.innerHTML =
              '<option value="">No tienes clases asignadas en el horario oficial</option>';
          } else {
            mySchedules.forEach((s) => {
              const opt = document.createElement("option");
              opt.value = String(s.id);
              // Formatear texto de opción: Materia — Día HH:MM-HH:MM (Grupo)
              opt.textContent = `${s.subject_name} — ${s.day_of_week} ${s.start_time.substring(0, 5)}-${s.end_time.substring(0, 5)} (${s.group_name || "Grupo " + s.class_group_id})`;
              opt.setAttribute("data-group-id", String(s.class_group_id));
              opt.setAttribute("data-subject", s.subject_name);
              opt.setAttribute("data-day", s.day_of_week);
              opt.setAttribute("data-start", s.start_time.substring(0, 5));
              opt.setAttribute("data-end", s.end_time.substring(0, 5));
              labScheduleSelect.appendChild(opt);
            });
          }
        }
      }

      // =========================================================================
      // CARGAR DATOS PARA ADMINISTRADOR
      // =========================================================================
      async function loadAllAdminData() {
        try {
          const [profRes, grpRes, carRes, schedRes, examRes] =
            await Promise.all([
              apiFetch("/api/professors"),
              apiFetch("/api/groups"),
              apiFetch("/api/reference/careers"),
              apiFetch("/api/schedules"),
              apiFetch("/api/exams"),
            ]);

          if (profRes.ok) professorsList = await profRes.json();
          if (grpRes.ok) groupsList = await grpRes.json();
          if (carRes.ok) careersList = await carRes.json();
          if (schedRes.ok) schedulesList = await schedRes.json();
          if (examRes.ok) examsList = await examRes.json();

          populateAdminSelectors();
          renderSchedulesTable();
          renderExamsTable();
          renderGroupsTable();
          renderTutorGroupsList();
        } catch (err) {
          console.error("Error al precargar datos para administración:", err);
        }
      }


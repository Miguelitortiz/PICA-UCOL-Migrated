      // SYLLABUS
      document
        .getElementById("form-syllabus")
        ?.addEventListener("submit", async (e) => {
          e.preventDefault();
          const sylSubjectSelect = document.getElementById("syl-subject") as HTMLSelectElement;
          const subject = sylSubjectSelect.value;
          const careerId = (
            document.getElementById("syl-career") as HTMLInputElement
          ).value;
          const description = (
            document.getElementById("syl-description") as HTMLTextAreaElement
          ).value.trim();
          const resTitle = (
            document.getElementById("res-title-1") as HTMLInputElement
          ).value.trim();
          const resAuthor = (
            document.getElementById("res-author-1") as HTMLInputElement
          ).value.trim();
          const resLink = (
            document.getElementById("res-link-1") as HTMLInputElement
          ).value.trim();

          // Recopilar criterios dinámicos
          const criteriaRows = document.querySelectorAll(".criteria-row");
          const evaluation_criteria: Record<string, string> = {};
          let totalPct = 0;
          
          criteriaRows.forEach((row) => {
            const descInput = row.querySelector(".crit-desc-input") as HTMLInputElement;
            const pctInput = row.querySelector(".crit-input-pct") as HTMLInputElement;
            const desc = descInput ? descInput.value.trim() : "";
            const pctVal = pctInput ? parseInt(pctInput.value, 10) || 0 : 0;
            if (desc) {
              evaluation_criteria[desc] = `${pctVal}%`;
              totalPct += pctVal;
            }
          });

          // Validar suma 100%
          if (totalPct !== 100) {
            alert(
              `Error: La suma de los criterios de evaluación debe ser exactamente del 100%. Suma actual: ${totalPct}%`,
            );
            return;
          }

          const resources: any[] = [];
          if (resTitle)
            resources.push({
              title: resTitle,
              author: resAuthor || "",
              link: resLink || "#",
            });

          const payload = {
            subject_name: subject,
            career_id: careerId,
            program_description: description,
            evaluation_criteria,
            resources,
            created_by: currentUser?.professor_id || null,
          };

          const res = await apiFetch("/api/syllabus", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (res.ok) {
            alert("¡Plan de estudios guardado correctamente!");
            
            // Refrescar lista de syllabus local
            const sylRes = await apiFetch("/api/syllabus");
            if (sylRes.ok) {
              syllabusList = await sylRes.json();
            }

            (
              document.getElementById("form-syllabus") as HTMLFormElement
            ).reset();
            // Disparar evento de cambio para re-detectar carrera y pre-llenar campos
            if (sylSubjectSelect) {
              sylSubjectSelect.dispatchEvent(new Event("change"));
            }
          } else {
            const err = await res.json();
            alert("Error: " + err.error);
          }
        });


---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AdminHUB - Control de Gestión Docente y Administrativa">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Cabecera del panel con rol activo -->
    <div class="bg-white border border-border-sutil rounded-sm p-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="font-mono text-[9px] uppercase tracking-wider text-secondary font-bold">Consola de Control / AdminHUB</span>
        <h1 class="font-display text-2xl font-bold text-text-primary">
          Gestión del Claustro y Programas
        </h1>
        <p class="text-xs text-text-secondary">
          Panel de administración académica y carga de programas de estudio de la Universidad de Colima.
        </p>
      </div>

      <!-- Indicador de rol activo (reemplaza el simulador) -->
      <div id="active-role-badge" class="w-full md:w-auto bg-bg-piedra/60 p-3 border border-border-sutil rounded-sm flex items-center gap-3">
        <div id="role-indicator-dot" class="w-3 h-3 rounded-full bg-primary flex-shrink-0"></div>
        <div>
          <div class="font-mono text-[9px] uppercase tracking-wider font-bold text-text-secondary">Sesión Activa</div>
          <div id="role-active-name" class="text-xs font-bold text-text-primary">Cargando...</div>
          <div id="role-active-label" class="font-mono text-[9px] text-text-secondary uppercase tracking-wider"></div>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 1. VISTAS DEL DOCENTE (Panel Docente) -->
    <!-- ========================================== -->
    <div id="panel-docente" class="space-y-6 role-panel hidden">

      <!-- SECCIÓN: MIS GRUPOS ASIGNADOS -->
      <div class="bg-white border border-border-sutil rounded-sm">
        <div class="flex items-center gap-3 px-4 py-3 border-b border-border-sutil bg-bg-piedra/30">
          <span class="font-mono text-xs font-bold text-primary uppercase">📚 Mis Grupos y Materias</span>
        </div>
        <div id="profesor-grupos-container" class="p-4">
          <p class="text-xs text-text-secondary italic">Cargando grupos asignados...</p>
        </div>
      </div>

      <!-- Pestañas Docente -->
      <div class="bg-white border border-border-sutil rounded-sm flex flex-col min-h-[500px]">
        <!-- Encabezado de Pestañas -->
        <div class="flex flex-wrap border-b border-border-sutil font-sans text-[10px] sm:text-xs uppercase tracking-wider font-bold bg-bg-piedra/30">
          <button class="docente-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-primary text-primary cursor-pointer transition-suiza" data-tab="cv-editor">
            Curriculum Vitae (PDF)
          </button>
          <button class="docente-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-suiza" data-tab="syllabus-editor">
            Cargar Plan de Estudios
          </button>
          <button class="docente-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-suiza" data-tab="lab-scheduler">
            Asignación de Laboratorios
          </button>
        </div>

        <!-- Contenido de Pestañas Docente -->
        <div class="p-6 flex-grow">
          
          <!-- SUBTAB 1: CV EDITOR (PDF UPLOAD) -->
          <div id="docente-tab-cv-editor" class="docente-tab-panel space-y-6">
            <div id="upload-container" class="border-2 border-dashed border-border-sutil rounded-sm p-12 text-center hover:border-primary transition-suiza cursor-pointer bg-white">
              <input type="file" id="pdf-input" accept=".pdf" class="hidden" />
              <div class="space-y-4">
                <div class="text-4xl text-primary">📁</div>
                <div class="space-y-2">
                  <p class="font-bold text-sm">Arrastra y suelta el PDF de tu currículum aquí</p>
                  <p class="text-[10px] text-text-secondary font-mono">o haz clic para buscar el archivo en tu equipo</p>
                </div>
                <p class="text-[9px] text-text-secondary/70 max-w-md mx-auto leading-relaxed">
                  * El PDF debe seguir el formato oficial de la Universidad de Colima (CV2026).
                </p>
              </div>
            </div>

            <!-- Loader -->
            <div id="loading-container" class="hidden border border-border-sutil rounded-sm p-12 text-center bg-white space-y-6">
              <div class="relative w-12 h-12 mx-auto flex items-center justify-center">
                <div class="absolute inset-0 border-2 border-bg-piedra rounded-full"></div>
                <div class="absolute inset-0 border-2 border-t-primary rounded-full animate-spin"></div>
                <span class="font-mono text-[9px] text-primary font-bold">PDF</span>
              </div>
              <p class="font-mono text-xs text-text-secondary" id="loading-status">Ejecutando extractor curricular...</p>
            </div>

            <!-- Error -->
            <div id="error-container" class="hidden border border-error/40 rounded-sm p-6 text-center bg-white space-y-4">
              <div class="text-xs text-error font-bold">⚠️ Error de Extracción</div>
              <p class="text-[10px] font-mono text-text-secondary" id="error-message"></p>
              <button id="btn-error-retry" class="px-4 border border-border-sutil text-xs font-mono rounded-sm hover:bg-bg-piedra transition-suiza cursor-pointer h-11 flex items-center justify-center">
                Intentar de nuevo
              </button>
            </div>

            <!-- CV Form Editor Interactiva (Oculto por defecto) -->
            <div id="cv-editor-form" class="hidden space-y-4">
              <div class="p-4 border border-border-sutil rounded-sm bg-bg-piedra/20 flex justify-between items-center">
                <div>
                  <h3 id="cv-doc-name" class="font-bold text-sm text-text-primary">Docente</h3>
                  <p class="text-[10px] text-text-secondary">Edita el CV recuperado del PDF y guárdalo en la base de datos.</p>
                </div>
                <button id="btn-save-cv" class="px-6 bg-primary text-white text-xs font-mono font-bold uppercase rounded-sm hover:bg-opacity-90 transition-suiza cursor-pointer h-11 flex items-center justify-center">
                  Guardar Perfil (CV) en BD
                </button>
              </div>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                <div class="card-suiza bg-white space-y-3">
                  <h4 class="font-bold text-xs text-primary uppercase">Datos Personales</h4>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Nombre Completo</label>
                    <input type="text" id="cv-field-name" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Correo Institucional</label>
                    <input type="email" id="cv-field-email" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                  </div>
                </div>

                <div class="card-suiza bg-white space-y-3">
                  <h4 class="font-bold text-xs text-primary uppercase">Adscripción</h4>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Unidad Académica (DES)</label>
                    <input type="text" id="cv-field-unit" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Nombramiento</label>
                    <input type="text" id="cv-field-appointment" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SUBTAB 2: SYLLABUS EDITOR -->
          <div id="docente-tab-syllabus-editor" class="docente-tab-panel hidden space-y-6">
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Subir Programa de Estudio / Syllabus</h3>
              
              <form id="form-syllabus" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Seleccionar Materia asignada (Slider/Dropdown)</label>
                    <select id="syl-subject" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold animate-pulse-once" required>
                      <!-- Cargado dinámicamente según las materias asignadas del docente -->
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Carrera Destino</label>
                    <select id="syl-career" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <!-- Cargado dinámicamente -->
                    </select>
                  </div>
                </div>

                <div>
                  <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Descripción General de la Asignatura</label>
                  <textarea id="syl-description" rows="4" placeholder="Escribe la descripción general de la materia y objetivos principales del programa..." class="w-full border border-border-sutil rounded-sm p-3 outline-none focus:border-secondary leading-relaxed" required></textarea>
                </div>

                <div class="divider-suizo"></div>

                <!-- Criterios de Evaluación -->
                <div class="space-y-3">
                  <div class="flex justify-between items-center">
                    <h4 class="font-bold text-xs text-primary uppercase">Criterios de Evaluación y Calificación (%)</h4>
                    <span id="crit-total-indicator" class="font-mono text-xs font-bold text-text-secondary bg-bg-piedra px-2 py-0.5 border border-border-sutil rounded-sm">Suma: 0%</span>
                  </div>
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Exámenes</label>
                      <input id="crit-exams" type="number" min="0" max="100" placeholder="Ej: 50" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11 crit-input-pct" required />
                    </div>
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Proyecto Integrador</label>
                      <input id="crit-project" type="number" min="0" max="100" placeholder="Ej: 30" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11 crit-input-pct" required />
                    </div>
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Tareas</label>
                      <input id="crit-assignments" type="number" min="0" max="100" placeholder="Ej: 20" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11 crit-input-pct" required />
                    </div>
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Quizzes / Otros</label>
                      <input id="crit-quizzes" type="number" min="0" max="100" placeholder="Ej: 0" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11 crit-input-pct" required />
                    </div>
                  </div>
                </div>

                <div class="divider-suizo"></div>

                <!-- Bibliografía y Recursos -->
                <div class="space-y-3">
                  <h4 class="font-bold text-xs text-primary uppercase">Bibliografía y Recursos (Libro 1)</h4>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Título del Recurso</label>
                      <input id="res-title-1" type="text" placeholder="Ej: Design Patterns: Elements..." class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                    </div>
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Autor</label>
                      <input id="res-author-1" type="text" placeholder="Ej: Erich Gamma" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                    </div>
                    <div>
                      <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Link de Consulta (Opcional)</label>
                      <input id="res-link-1" type="text" placeholder="http://..." class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11" />
                    </div>
                  </div>
                </div>

                <div class="pt-4 flex justify-between items-center border-t border-bg-piedra">
                  <span class="text-[10px] text-text-secondary font-mono">El plan se guardará con tu autoría como docente activo.</span>
                  <button type="submit" class="px-6 bg-primary text-white text-xs font-mono font-bold uppercase rounded-sm hover:bg-opacity-90 transition-suiza cursor-pointer h-11 flex items-center justify-center">
                    Guardar Plan de Estudios
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- SUBTAB 3: LAB SCHEDULER -->
          <div id="docente-tab-lab-scheduler" class="docente-tab-panel hidden space-y-6">
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Asignación / Reserva de Laboratorio</h3>
              <p class="text-xs text-text-secondary">
                Como docente, registra en qué laboratorios impartes clases de tus materias asignadas en el horario oficial.
              </p>

              <form id="form-lab-schedule" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Seleccionar Laboratorio</label>
                    <select id="lab-room" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <option value="Laboratorio de Cómputo 3">Laboratorio de Cómputo 3 (Edificio B)</option>
                      <option value="Laboratorio de Telemática 1">Laboratorio de Telemática 1 (Edificio C)</option>
                      <option value="Laboratorio de Electrónica">Laboratorio de Electrónica (Edificio D)</option>
                      <option value="Laboratorio de Redes">Laboratorio de Redes (Edificio C)</option>
                      <option value="Laboratorio de Física">Laboratorio de Física (Edificio A)</option>
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Materia asignada</label>
                    <select id="lab-subject" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <!-- Cargado dinámicamente -->
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Grupo Académico</label>
                    <select id="lab-group" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <!-- Cargado dinámicamente -->
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Día de la Semana</label>
                    <select id="lab-day" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <option value="Lunes">Lunes</option>
                      <option value="Martes">Martes</option>
                      <option value="Miércoles">Miércoles</option>
                      <option value="Jueves">Jueves</option>
                      <option value="Viernes">Viernes</option>
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Hora Inicio</label>
                    <input id="lab-start" type="time" value="09:00" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Hora Fin</label>
                    <input id="lab-end" type="time" value="11:00" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                </div>

                <div class="pt-4 border-t border-bg-piedra flex justify-end">
                  <button type="submit" class="px-6 bg-primary text-white text-xs font-mono font-bold uppercase rounded-sm hover:bg-opacity-90 transition-suiza cursor-pointer h-11 flex items-center justify-center">
                    Reservar Laboratorio
                  </button>
                </div>
              </form>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 2. VISTAS ADMINISTRATIVAS (Panel Admin) -->
    <!-- ========================================== -->
    <div id="panel-administrativo" class="space-y-6 role-panel hidden">
      <div class="bg-white border border-border-sutil rounded-sm flex flex-col min-h-[500px]">
        <!-- Encabezado de Pestañas Admin -->
        <div class="flex flex-wrap border-b border-border-sutil font-sans text-[10px] sm:text-xs uppercase tracking-wider font-bold bg-bg-piedra/30">
          <button class="admin-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-primary text-primary cursor-pointer transition-suiza" data-tab="schedules-mgr">
            Gestión de Horarios
          </button>
          <button class="admin-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-suiza" data-tab="tutor-mgr">
            Asignar Tutores
          </button>
          <button class="admin-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-suiza" data-tab="exams-mgr">
            Programar Exámenes
          </button>
          <button class="admin-tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-suiza" data-tab="groups-mgr">
            Gestión de Grupos
          </button>
        </div>

        <!-- Contenido de Pestañas Admin -->
        <div class="p-6 flex-grow">
          
          <!-- SUBTAB 1: HORARIOS MANAGER -->
          <div id="admin-tab-schedules-mgr" class="admin-tab-panel space-y-6">
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Crear Horario de Clase</h3>
              
              <form id="form-admin-schedule" class="space-y-4 text-xs">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Grupo Escolar</label>
                    <select id="sched-group" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <!-- Cargado dinámicamente -->
                    </select>
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Materia</label>
                    <input id="sched-subject" type="text" placeholder="Ej: Patrones de Diseño" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Docente Asignado</label>
                    <select id="sched-professor" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <!-- Cargado dinámicamente -->
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Aula / Salón</label>
                    <input id="sched-classroom" type="text" placeholder="Ej: Aula 401" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Día</label>
                    <select id="sched-day" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary h-11 font-bold" required>
                      <option value="Lunes">Lunes</option>
                      <option value="Martes">Martes</option>
                      <option value="Miércoles">Miércoles</option>
                      <option value="Jueves">Jueves</option>
                      <option value="Viernes">Viernes</option>
                    </select>
                  </div>
                  <div class="flex items-center h-11 pt-2">
                    <label class="flex items-center gap-2 font-mono text-[10px] uppercase font-bold text-text-secondary cursor-pointer min-h-[44px]">
                      <input id="sched-islab" type="checkbox" class="w-4 h-4 rounded-sm border-border-sutil text-primary focus:ring-secondary" />
                      ¿Es un Laboratorio?
                    </label>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Hora Inicio</label>
                    <input id="sched-start" type="time" value="07:00" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                  <div>
                    <label class="font-mono text-[9px] uppercase tracking-wider block text-text-secondary mb-1">Hora Fin</label>
                    <input id="sched-end" type="time" value="09:00" class="w-full border border-border-sutil rounded-sm px-3 outline-none focus:border-secondary font-bold h-11" required />
                  </div>
                </div>

                <div class="pt-4 border-t border-bg-piedra flex justify-end">
                  <button type="submit" class="px-6 bg-primary text-white text-xs font-mono font-bold uppercase rounded-sm hover:bg-opacity-90 transition-suiza cursor-pointer h-11 flex items-center justify-center">
                    Agregar Clase al Horario
                  </button>
                </div>
              </form>
            </div>

            <!-- Listado de Horarios Existentes -->
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Clases Programadas en el Sistema</h3>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="border-b border-border-sutil bg-bg-piedra">
                      <th class="p-2 font-mono text-[9px] uppercase">Grupo</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Materia</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Profesor</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Aula</th>
                      <th class="p-2 font-mono text-[9px] uppercase">Horario</th>
                      <th class="p-2 font-mono text-[9px] uppercase text-right">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="table-schedules-list">
                    <!-- Cargados dinámicamente -->
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- SUBTAB 2: TUTORES MANAGER -->
          <div id="admin-tab-tutor-mgr" class="admin-tab-panel hidden space-y-6">
            <div class="card-suiza bg-white space-y-4">
              <h3 class="font-bold text-sm text-primary uppercase border-b border-border-sutil pb-2">Asignar Tutor de Grupo</h3>
              <p class="text-xs text-text-secondary">
                Selecciona un grupo escolar y el docente que fungirá como tutor para brindar asesorías.

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Panel de Administración y Gestión Curricular PICA-UCOL' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} &mdash; AdminHUB PICA-UCOL</title>
  </head>
  <body class="bg-bg-papel text-text-primary font-sans min-h-screen flex flex-col antialiased">
    <!-- Banda superior de acento verde institucional -->
    <div class="h-1.5 bg-primary w-full"></div>

    <!-- Encabezado Académico Superior -->
    <header class="border-b border-border-sutil bg-white py-3 px-6 sm:px-12 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
        <div class="flex items-center gap-3">
          <div class="font-mono text-xl font-bold border-r border-border-sutil pr-4 text-primary">
            ■ ADMIN
          </div>
          <div class="flex flex-col">
            <span class="font-display font-semibold text-lg tracking-tight uppercase">AdminHUB PICA-UCOL</span>
            <span class="font-mono text-[9px] text-text-secondary uppercase tracking-widest font-bold">Universidad de Colima &bull; Módulo de Carga</span>
          </div>
        </div>

        <!-- Zona de usuario autenticado -->
        <div class="flex items-center gap-3">
          <!-- Info del usuario (cargada desde JS) -->
          <div id="user-info-badge" class="hidden items-center gap-2 bg-bg-piedra/70 border border-border-sutil rounded-sm px-3 h-9">
            <div id="user-role-dot" class="w-2 h-2 rounded-full bg-primary flex-shrink-0"></div>
            <div class="flex flex-col">
              <span id="user-display-name" class="font-mono text-[10px] font-bold text-text-primary leading-tight"></span>
              <span id="user-role-label" class="font-mono text-[8px] text-text-secondary uppercase tracking-wider leading-tight"></span>
            </div>
          </div>

          <!-- Enlace rápido a StudentHUB -->
          <a href="/" class="text-[10px] font-mono border border-border-sutil px-3 h-9 rounded-sm hover:bg-bg-piedra transition-suiza no-underline text-text-secondary font-bold inline-flex items-center justify-center">
            &larr; StudentHUB
          </a>

          <!-- Botón Cerrar Sesión -->
          <button
            id="btn-logout"
            type="button"
            class="hidden text-[10px] font-mono border border-error/30 bg-error/5 hover:bg-error/10 text-error px-3 h-9 rounded-sm transition-suiza font-bold cursor-pointer"
          >
            Salir
          </button>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow py-8 px-4 sm:px-8 max-w-6xl w-full mx-auto">
      <slot />
    </main>

    <!-- Pie de Página -->
    <footer class="border-t border-border-sutil py-6 px-6 text-center bg-bg-piedra/60 text-xs font-mono text-text-secondary mt-12">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>
          <span>Panel Administrativo y de Carga Académica &bull; PICA-UCOL</span>
        </div>
        <div class="flex gap-4">
          <span>Universidad de Colima</span>
        </div>
      </div>
    </footer>

    <!-- Script de sesión compartido -->
    <script>
      // Mapeo de roles a etiquetas legibles
      const ROLE_LABELS: Record<string, string> = {
        'docente': 'Docente',
        'jefe_carrera': 'Jefe de Carrera',
        'coordinador_facultad': 'Coordinador de Facultad',
        'admin_direccion': 'Admin. de Dirección',
        'admin_general': 'Administrador General'
      };

      const ROLE_COLORS: Record<string, string> = {
        'docente': '#527630',
        'jefe_carrera': '#006096',
        'coordinador_facultad': '#006096',
        'admin_direccion': '#774B1E',
        'admin_general': '#990000'
      };

      // Verificar sesión y redirigir a login si no existe
      function checkSession() {
        const token = localStorage.getItem('pica_jwt');
        if (!token) {
          window.location.href = '/admin/login';
          return null;
        }
        // Verificar expiración del token
        try {
          const payload = JSON.parse(atob(token.split('.')[1]));
          if (payload.exp * 1000 < Date.now()) {
            localStorage.removeItem('pica_jwt');
            localStorage.removeItem('pica_user');
            window.location.href = '/admin/login';
            return null;
          }
          return payload;
        } catch {
          localStorage.removeItem('pica_jwt');
          localStorage.removeItem('pica_user');
          window.location.href = '/admin/login';
          return null;
        }
      }

      // Mostrar info del usuario en el header
      function displayUserInfo(user: any) {
        const badge = document.getElementById('user-info-badge');
        const nameEl = document.getElementById('user-display-name');
        const roleEl = document.getElementById('user-role-label');
        const dot = document.getElementById('user-role-dot');
        const logoutBtn = document.getElementById('btn-logout');

        if (badge && nameEl && roleEl) {
          nameEl.textContent = user.professor_name || user.username || 'Usuario';
          roleEl.textContent = ROLE_LABELS[user.role] || user.role;
          if (dot) dot.style.backgroundColor = ROLE_COLORS[user.role] || '#527630';
          badge.classList.remove('hidden');
          badge.classList.add('flex');
        }
        if (logoutBtn) {
          logoutBtn.classList.remove('hidden');
        }
      }

      // Cerrar sesión
      document.getElementById('btn-logout')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (confirm('¿Estás seguro de que deseas cerrar sesión?')) {
          localStorage.removeItem('pica_jwt');
          localStorage.removeItem('pica_user');
          window.location.href = '/admin/login';
        }
      });

      // Verificar sesión al cargar
      const sessionUser = checkSession();
      if (sessionUser) {
        displayUserInfo(sessionUser);
      }

      // Exportar helper global de autenticación
      (window as any).getJwtToken = () => localStorage.getItem('pica_jwt');
      (window as any).getCurrentUser = () => {
        try {
          return JSON.parse(localStorage.getItem('pica_user') || 'null');
        } catch { return null; }
      };
    </script>
  </body>
</html>

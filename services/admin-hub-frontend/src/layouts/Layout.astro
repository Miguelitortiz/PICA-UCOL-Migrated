---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Panel de Administración y Gestión Curricular PICA-UCOL' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} &mdash; AdminHUB PICA-UCOL</title>
  </head>
  <body class="bg-bg-papel text-text-primary font-sans min-h-screen flex flex-col antialiased">
    <!-- Banda superior de acento verde institucional -->
    <div class="h-1.5 bg-primary w-full"></div>

    <!-- Encabezado Académico Superior -->
    <header class="border-b border-border-sutil bg-white py-4 px-6 sm:px-12 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-3">
          <div class="font-mono text-xl font-bold border-r border-border-sutil pr-4 text-primary">
            ■ ADMIN
          </div>
          <div class="flex flex-col">
            <span class="font-display font-semibold text-lg tracking-tight uppercase">AdminHUB PICA-UCOL</span>
            <span class="font-mono text-[9px] text-text-secondary uppercase tracking-widest font-bold">Universidad de Colima &bull; Módulo de Carga</span>
          </div>
        </div>

        <!-- Enlace rápido a StudentHUB -->
        <div>
          <a href="/" class="text-[10px] font-mono border border-border-sutil px-4 h-11 rounded-sm hover:bg-bg-piedra transition-suiza no-underline text-text-secondary font-bold inline-flex items-center justify-center">
            &larr; IR AL STUDENTHUB (PORTAL PÚBLICO)
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow py-8 px-4 sm:px-8 max-w-6xl w-full mx-auto">
      <slot />
    </main>

    <!-- Pie de Página -->
    <footer class="border-t border-border-sutil py-6 px-6 text-center bg-bg-piedra/60 text-xs font-mono text-text-secondary mt-12">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>
          <span>Panel Administrativo y de Carga Académica &bull; PICA-UCOL</span>
        </div>
        <div class="flex gap-4">
          <span>Universidad de Colima</span>
        </div>
      </div>
    </footer>
  </body>
</html>

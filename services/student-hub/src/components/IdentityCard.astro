---
interface Props {
  fullName: string;
  title: string;
  department: string;
  institutionalEmail: string;
  admissionYear: number;
  photoUrl?: string;
}

const {
  fullName,
  title,
  department,
  institutionalEmail,
  admissionYear,
  photoUrl
} = Astro.props;

// Calcular años de antigüedad
const currentYear = new Date().getFullYear();
const yearsOfService = currentYear - admissionYear;

// Obtener iniciales para el placeholder de foto
const initials = (fullName || 'P A')
  .split(' ')
  .filter(word => word.length > 2 && !['del', 'de', 'las', 'los'].includes(word.toLowerCase()))
  .slice(0, 2)
  .map(word => word[0])
  .join('')
  .toUpperCase();
---

<div class="py-2">
  <!-- Foto de perfil (Cuadrada, Grayscale de Alto Contraste) -->
  <div class="mb-6 w-full aspect-square border border-rule-strong overflow-hidden relative">
    {photoUrl ? (
      <img
        src={photoUrl}
        alt={`Fotografía de ${fullName}`}
        loading="lazy"
        width="300"
        height="300"
        class="w-full h-full object-cover filter grayscale contrast-125 brightness-95"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="hidden absolute inset-0 flex items-center justify-center font-mono text-3xl font-bold text-ink-3 tracking-widest bg-muted select-none">
        {initials}
      </div>
    ) : (
      <div class="flex items-center justify-center font-mono text-3xl font-bold text-ink-3 tracking-widest bg-muted w-full h-full select-none">
        {initials}
      </div>
    )}
  </div>

  <!-- Identidad -->
  <div class="text-left mb-6">
    <h1 class="text-xl sm:text-2xl font-black text-ink leading-none tracking-tight">
      {fullName}
    </h1>
    <span class="overline overline--primary mt-2">
      {title}
    </span>
  </div>

  <hr class="rule" style="margin: 24px 0;" />

  <!-- Detalles -->
  <dl class="space-y-4 text-left">
    <div>
      <dt class="field-label">Adscripción</dt>
      <dd class="field-value">{department}</dd>
    </div>
    <div>
      <dt class="field-label">Contacto</dt>
      <dd>
        <a href={`mailto:${institutionalEmail}`} class="link field-value font-mono" style="font-size: 0.8125rem;">
          {institutionalEmail}
        </a>
      </dd>
    </div>
    <div>
      <dt class="field-label">Año de Ingreso</dt>
      <dd class="field-value font-mono">
        {admissionYear} <span class="font-sans text-xs text-ink-3 font-normal ml-1">({yearsOfService} años de antigüedad)</span>
      </dd>
    </div>
  </dl>
</div>

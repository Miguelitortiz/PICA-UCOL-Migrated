---
interface Article {
  title: string;
  journal: string;
  year: number;
  impactFactor: number | null;
  doi: string | null;
}

interface Book {
  title: string;
  role: string;
  editorial: string;
  year: number;
}

interface Props {
  articles: Article[];
  books: Book[];
}

const { articles = [], books = [] } = Astro.props;

// Combinar artículos y libros en una sola lista cronológica para la vitrina y búsqueda
const allPubs = [
  ...articles.map(art => ({ ...art, type: 'article' as const })),
  ...books.map(bk => ({ ...bk, type: 'book' as const }))
].sort((a, b) => b.year - a.year);
---

<div class="space-y-6">
  
  <!-- Buscador e Interfaz de Filtros -->
  <div class="space-y-4">
    <input 
      type="text" 
      id="pub-search" 
      placeholder="Buscar por título, revista, editorial o año..." 
      class="w-full h-11 bg-ground border-none px-0 text-sm font-sans text-ink focus:outline-none placeholder:text-ink-3"
    />
    <div class="flex flex-wrap items-center gap-4">
      <span class="field-label" style="margin-bottom: 0;">Filtrar:</span>
      <button 
        class="filter-btn font-mono text-2xs uppercase tracking-wider font-black text-ink pb-1 border-b-2 border-primary cursor-pointer transition-all"
        data-filter="all"
      >
        Todos
      </button>
      <button 
        class="filter-btn font-mono text-2xs uppercase tracking-wider font-bold text-ink-3 pb-1 border-b-2 border-transparent cursor-pointer transition-all hover:text-ink"
        data-filter="article"
      >
        Artículos
      </button>
      <button 
        class="filter-btn font-mono text-2xs uppercase tracking-wider font-bold text-ink-3 pb-1 border-b-2 border-transparent cursor-pointer transition-all hover:text-ink"
        data-filter="book"
      >
        Libros
      </button>
    </div>
  </div>

  <!-- Contenedor Principal de Publicaciones (Lista bibliográfica suiza) -->
  <div id="publications-list" class="space-y-6">
    {allPubs.map(pub => (
      <div 
        class="pub-item border-b border-rule pb-6 flex flex-col md:flex-row md:items-start gap-4"
        data-title={pub.title.toLowerCase()}
        data-type={pub.type}
        data-journal={pub.type === 'article' ? pub.journal.toLowerCase() : pub.editorial.toLowerCase()}
        data-year={pub.year.toString()}
      >
        <!-- Año y Tipo -->
        <div class="w-24 shrink-0 flex items-center md:flex-col md:items-start gap-2">
          <span class="font-mono text-xs font-black text-primary">
            [{pub.year}]
          </span>
          <span class="tag">
            {pub.type === 'article' ? 'Artículo' : 'Libro'}
          </span>
        </div>
        
        <!-- Contenido Ficha -->
        <div class="flex-1 min-w-0">
          <h4 class="text-base font-bold text-ink leading-snug mb-1">
            {pub.type === 'article' ? `“${pub.title}”` : pub.title}
          </h4>
          <p class="text-xs text-ink-2 leading-relaxed">
            {pub.type === 'article' ? (
              <span>Publicado en <span class="italic font-medium">{pub.journal}</span>.</span>
            ) : (
              <span>Libro publicado por <span class="italic font-medium">{pub.editorial}</span>. Rol: {pub.role}.</span>
            )}
          </p>
          
          <div class="mt-2.5 flex items-center gap-4 text-2xs font-mono">
            {pub.type === 'article' && pub.impactFactor && (
              <span class="tag tag--primary">FI {pub.impactFactor}</span>
            )}
            {pub.doi && (
              <a href={pub.doi} target="_blank" rel="noopener noreferrer" class="link">
                → DOI / Enlace
              </a>
            )}
          </div>
        </div>
      </div>
    ))}

    <div 
      id="no-resultados" 
      class="hidden text-center py-12 text-xs italic text-ink-3 bg-muted"
    >
      No se encontraron publicaciones que coincidan con los filtros de búsqueda.
    </div>
  </div>

</div>

<!-- Script de filtrado interactivo -->
<script>
  function initFilters() {
    const searchInput = document.getElementById('pub-search') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll('.filter-btn');
    const publicationsList = document.getElementById('publications-list');
    const noResultados = document.getElementById('no-resultados');

    if (!searchInput || !publicationsList) return;

    let activeFilter = 'all';

    function filterPublications() {
      const query = searchInput.value.toLowerCase().trim();
      const items = publicationsList.querySelectorAll('.pub-item');
      let matchesCount = 0;

      items.forEach((item: any) => {
        const title = item.getAttribute('data-title') || '';
        const journal = item.getAttribute('data-journal') || '';
        const year = item.getAttribute('data-year') || '';
        const type = item.getAttribute('data-type') || '';

        const matchesSearch = title.includes(query) || journal.includes(query) || year.includes(query);
        const matchesType = activeFilter === 'all' || type === activeFilter;

        if (matchesSearch && matchesType) {
          item.style.display = 'flex';
          matchesCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Validar si hubo coincidencias
      if (matchesCount === 0) {
        noResultados?.classList.remove('hidden');
      } else {
        noResultados?.classList.add('hidden');
      }
    }

    searchInput.addEventListener('input', filterPublications);

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('border-primary', 'font-black', 'text-ink');
          b.classList.add('border-transparent', 'font-bold', 'text-ink-3');
        });

        btn.classList.add('border-primary', 'font-black', 'text-ink');
        btn.classList.remove('border-transparent', 'font-bold', 'text-ink-3');

        activeFilter = btn.getAttribute('data-filter') || 'all';
        filterPublications();
      });
    });
  }

  // Ejecutar en carga de página y transiciones Astro
  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>

---
interface Article {
  impactFactor: number | null;
}

interface Thesis {}

interface AcademicBody {
  name: string;
  level: string;
}

interface Props {
  admissionYear: number;
  articles: Article[];
  theses: Thesis[];
  academicBody?: AcademicBody;
}

const {
  admissionYear,
  articles = [],
  theses = [],
  academicBody
} = Astro.props;

const currentYear = new Date().getFullYear();
const yearsOfService = currentYear - admissionYear;

// Contar artículos JCR
const jcrArticlesCount = articles.filter(art => art.impactFactor !== null).length;
const totalArticlesCount = articles.length;
const thesesCount = theses.length;
---

<div class="space-y-6 py-2">
  <span class="overline overline--primary border-b border-rule pb-2 w-full block">
    Indicadores de Impacto
  </span>

  <div class="space-y-4">
    <!-- Años de servicio -->
    <div>
      <div class="text-3xl font-black text-ink font-mono tracking-tighter">
        {yearsOfService}
      </div>
      <span class="field-label mt-1">Años de Servicio</span>
    </div>

    <!-- Artículos JCR / Totales -->
    <div>
      <div class="text-3xl font-black text-ink font-mono tracking-tighter">
        {jcrArticlesCount}<span class="text-base font-normal text-ink-3"> / {totalArticlesCount}</span>
      </div>
      <span class="field-label mt-1">Artículos JCR / Indexados</span>
    </div>

    <!-- Tesis dirigidas -->
    <div>
      <div class="text-3xl font-black text-ink font-mono tracking-tighter">
        {thesesCount}
      </div>
      <span class="field-label mt-1">Tesis Asesoradas</span>
    </div>

    <!-- Cuerpo Académico -->
    {academicBody && (
      <div class="border-t border-rule pt-4 mt-2">
        <span class="field-label">Cuerpo Académico</span>
        <div class="field-value text-sm mt-1">
          {academicBody.name}
        </div>
        <span class="tag tag--primary mt-2">
          {academicBody.level}
        </span>
      </div>
    )}
  </div>
</div>

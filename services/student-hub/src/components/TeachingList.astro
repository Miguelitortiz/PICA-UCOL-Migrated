---
interface Course {
  name: string;
  level: string;
  students: number;
  period: string;
}

interface Thesis {
  student: string;
  title: string;
  year: number;
  role: string;
}

interface Props {
  courses?: Course[];
  theses?: Thesis[];
  showOnly?: 'courses' | 'theses';
}

const { courses = [], theses = [], showOnly } = Astro.props;

// Extraer solo los 3 cursos principales
const visibleCourses = courses;

// Extraer máximo 2 tesis para la vista principal
const visibleTheses = theses;
const extraThesesCount = theses.length - 2;

// Función para abreviar nombres de materias y mantener los badges pequeños
function abbreviateCourse(name: string) {
  let short = name
    .replace(/Fundamentos de /gi, "Fund. ")
    .replace(/Programación /gi, "Prog. ")
    .replace(/ e /gi, " y ")
    .replace(/Orientada a Objetos/gi, "OO")
    .replace(/Inteligencia Artificial/gi, "IA")
    .replace(/Ciencia de Datos/gi, "CD");

  if (short.length > 25) {
    short = short.slice(0, 22) + "...";
  }
  return short;
}
---

<div class="space-y-6">
  <!-- Sección de Cursos Impartidos -->
  {(!showOnly || showOnly === 'courses') && (
    <div>
      <span class="overline overline--primary mb-4 block">Cursos Impartidos</span>
      {
        visibleCourses.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {visibleCourses.map((course) => (
              <div class="border-b border-rule pb-4 flex flex-col justify-between">
                <div>
                  <span class="tag tag--primary mb-2">
                    {course.level}
                  </span>
                  <h4 class="text-sm font-bold text-ink leading-snug">
                    {course.name}
                  </h4>
                </div>
                <div class="mt-4 flex items-center justify-between text-2xs font-mono text-ink-3">
                  <div>
                    <span>Periodo:</span>
                    <span class="font-bold text-ink-2 ml-1">{course.period}</span>
                  </div>
                  <div>
                    <span>Alumnos:</span>
                    <span class="font-bold text-ink-2 ml-1">{course.students}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-xs italic text-ink-3">
            No se registran cursos impartidos recientemente.
          </p>
        )
      }
    </div>
  )}

  {!showOnly && courses.length > 0 && theses.length > 0 && (
    <hr class="rule" style="margin: 24px 0;" />
  )}

  <!-- Sección de Tesis Dirigidas (Máx 2 items + ver más) -->
  {(!showOnly || showOnly === 'theses') && (
    <div>
      <span class="overline overline--primary mb-4 block">Tesis Asesoradas</span>
      {
        visibleTheses.length > 0 ? (
          <div class="space-y-4">
            {visibleTheses.map((thesis) => (
              <div class="border-b border-rule pb-4 text-xs">
                <h4 class="text-sm font-bold text-ink leading-snug italic mb-2">
                  “{thesis.title}”
                </h4>
                <div class="flex flex-wrap justify-between items-center text-2xs font-mono text-ink-3">
                  <div>
                    Tesista:{" "}
                    <span class="font-bold text-ink-2">
                      {thesis.student}
                    </span>
                  </div>
                  <div>
                    {thesis.role} &bull; {thesis.year}
                  </div>
                </div>
              </div>
            ))}

            {extraThesesCount > 0 && (
              <div class="pt-2 text-right">
                <button
                  data-open="modal-tesis"
                  class="link font-mono text-xs font-bold cursor-pointer"
                >
                  +{extraThesesCount} tesis más →
                </button>
              </div>
            )}
          </div>
        ) : (
          <p class="text-xs italic text-ink-3">
            No se registran tesis recientes.
          </p>
        )
      }
    </div>
  )}
</div>

<!-- ========================================== -->
<!-- MODALES DE REGISTRO COMPLETO (Vanilla JS) -->
<!-- ========================================== -->

<!-- Modal Tesis -->
{(!showOnly || showOnly === 'theses') && (
  <div
    id="modal-tesis"
    class="modal-overlay fixed inset-0 bg-ink/60 hidden items-center justify-center p-4 z-50 transition-opacity duration-150"
    style="background: rgba(26,26,26,0.6);"
  >
    <div
      class="bg-white w-full max-w-2xl max-h-[85vh] flex flex-col relative"
      style="background: var(--color-surface);"
    >
      <div style="height: 3px; background-color: var(--color-primary);"></div>

      <!-- Encabezado Modal -->
      <div
        class="border-b border-rule p-6 flex justify-between items-start gap-4"
      >
        <div>
          <span class="overline overline--primary">Expediente de Grados</span>
          <h2 style="font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin-top: 4px; line-height: 1.2;">
            Tesis Asesoradas y Dirigidas
          </h2>
        </div>
        <button
          class="close-modal"
          aria-label="Cerrar detalle"
          style="background: none; border: none; font-size: 1.5rem; color: var(--color-ink-3); cursor: pointer; padding: 0 4px; line-height: 1;"
        >
          ×
        </button>
      </div>

      <!-- Contenido Scrollable -->
      <div class="p-6 overflow-y-auto scroll flex-1 space-y-4">
        {
          theses.map((thesis) => (
            <div class="border-b border-rule pb-4 text-xs">
              <span class="field-label mb-1">
                Proyecto de Grado
              </span>
              <h4 class="text-sm font-bold text-ink leading-snug italic mb-2">
                “{thesis.title}”
              </h4>
              <div class="flex flex-wrap justify-between items-center text-2xs font-mono text-ink-3">
                <div>
                  Tesista: <span class="font-bold text-ink-2">{thesis.student}</span>
                </div>
                <div>
                  {thesis.role} &bull; {thesis.year}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
)}

<script>
  function setupThesisModal() {
    const openBtns = document.querySelectorAll('[data-open="modal-tesis"]');
    const modal = document.getElementById('modal-tesis');
    const closeBtn = modal?.querySelector('.close-modal');

    if (!modal) return;

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  }

  setupThesisModal();
  document.addEventListener('astro:page-load', setupThesisModal);
</script>

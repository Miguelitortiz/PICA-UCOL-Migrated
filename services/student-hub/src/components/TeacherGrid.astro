---
interface Teacher {
  slug: string;
  fullName: string;
  photoUrl?: string;
  title: string;
  department: string;
  quote: string;
  delegation_id?: number;
  faculty_id?: number;
  career_ids?: number[];
}

interface Props {
  profesores: Teacher[];
}

const { profesores = [] } = Astro.props;

function getInitials(name: string) {
  return name
    .split(' ')
    .filter(word => word.length > 2 && !['del', 'de', 'las', 'los'].includes(word.toLowerCase()))
    .slice(0, 2)
    .map(word => word[0])
    .join('')
    .toUpperCase();
}
---

<div class="teachers-grid">
  {profesores.map((prof) => {
    const initials = getInitials(prof.fullName);
    return (
      <div
        class="teacher-card"
        data-delegation={prof.delegation_id}
        data-faculty={prof.faculty_id || ''}
        data-careers={JSON.stringify(prof.career_ids || [])}
        style="
          background-color: white;
          border: 1px solid var(--color-border);
          border-left: 3px solid var(--color-primary);
          border-radius: 2px;
          padding: 20px;
          display: flex;
          flex-direction: row;
          gap: 16px;
          transition: border-color 150ms;
        "
        onmouseover="this.style.borderColor='var(--color-secondary)'; this.style.borderLeftColor='var(--color-secondary)';"
        onmouseout="this.style.borderColor='var(--color-border)'; this.style.borderLeftColor='var(--color-primary)';"
      >
        <!-- Avatar -->
        <div style="flex-shrink: 0;">
          <div style="
            width: 72px;
            height: 72px;
            background-color: var(--color-bg-piedra);
            border: 1px solid var(--color-border);
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
          ">
            {prof.photoUrl ? (
              <>
                <img
                  src={prof.photoUrl}
                  alt={`Fotografía de ${prof.fullName}`}
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%) contrast(1.1);"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div style="
                  display: none;
                  position: absolute;
                  inset: 0;
                  align-items: center;
                  justify-content: center;
                  font-family: var(--font-sans);
                  font-size: 1.25rem;
                  font-weight: 700;
                  letter-spacing: 0.04em;
                  color: var(--color-border);
                ">{initials}</div>
              </>
            ) : (
              <span style="
                font-family: var(--font-sans);
                font-size: 1.25rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                color: var(--color-border);
              ">{initials}</span>
            )}
          </div>
        </div>

        <!-- Información -->
        <div style="flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 8px;">
          <div>
            <h2 style="
              font-size: 0.9375rem;
              font-weight: 700;
              color: var(--color-text-primary);
              line-height: 1.2;
              margin-bottom: 4px;
            ">
              <a
                href={`/profesores/${prof.slug}`}
                style="color: inherit; text-decoration: none; transition: color 150ms;"
                onmouseover="this.style.color='var(--color-primary)';"
                onmouseout="this.style.color='var(--color-text-primary)';"
              >{prof.fullName}</a>
            </h2>
            <span class="swiss-label swiss-label--primary" style="display: block; margin-bottom: 6px;">
              {prof.title}
            </span>
            <p style="
              font-size: 0.75rem;
              color: var(--color-text-secondary);
              line-height: 1.3;
              overflow: hidden;
              white-space: nowrap;
              text-overflow: ellipsis;
            ">{prof.department}</p>
            {prof.quote && (
              <p style="
                font-size: 0.75rem;
                font-style: italic;
                color: var(--color-ink-3);
                border-left: 2px solid var(--color-border);
                padding-left: 10px;
                margin-top: 8px;
                line-height: 1.4;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
              ">"{prof.quote}"</p>
            )}
          </div>
          <div>
            <a
              href={`/profesores/${prof.slug}`}
              style="
                font-family: var(--font-mono);
                font-size: 0.5625rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--color-secondary);
                text-decoration: none;
              "
              onmouseover="this.style.textDecoration='underline';"
              onmouseout="this.style.textDecoration='none';"
            >Ver perfil completo &rarr;</a>
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
  .teachers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .teachers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import { cargarCarreras, cargarSyllabusPorSlug } from "../../lib/cargarDatos.js";

const { slug } = Astro.params;

// Cargar datos de la base de datos para este plan de estudios
const syllabus = await cargarSyllabusPorSlug(slug);

if (!syllabus) {
  return Astro.redirect("/404");
}

const careers = await cargarCarreras();
const career = careers.find(c => c.id === syllabus.career_id);
const careerName = career ? career.name : "Carrera Desconocida";

// Formatear criterios de evaluación
const criteriaData = syllabus.evaluation_criteria || {};
const isPartialsArray = Array.isArray(criteriaData);
const criteriaKeys = isPartialsArray ? [] : Object.keys(criteriaData);

// Formatear recursos
const resources = Array.isArray(syllabus.resources) ? syllabus.resources : [];

// Profesor adscrito
const professorProfile = syllabus.profile_data || {};
const contactInfo = professorProfile.contactInfo || {};
---

<InstitutionalLayout title={`${syllabus.subject_name} - Plan de Estudios`}>
  <div class="space-y-8">
    
    <!-- Migas de Pan / Navegación Secundaria -->
    <div class="text-[10px] font-mono uppercase tracking-wider text-ink-3 flex items-center gap-2">
      <a href="/materias" class="hover:text-primary no-underline transition-colors duration-120">Materias</a>
      <span>&gt;</span>
      <span class="text-ink font-bold">{syllabus.subject_name}</span>
    </div>

    <!-- Encabezado de la Materia -->
    <div class="page-header">
      <span class="overline overline--primary" style="margin-bottom: 8px;">
        {careerName}
      </span>
      <h1 class="page-title">
        {syllabus.subject_name}
      </h1>
      <p class="page-subtitle">
        Programa de asignatura oficial de la Universidad de Colima. Modificado por última vez: {new Date(syllabus.updated_at).toLocaleDateString('es-MX')}
      </p>
    </div>

    <hr class="rule rule--strong" style="margin-top: 12px; margin-bottom: 24px;" />

    <!-- Contenido Detallado -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Detalle Académico (2/3 de la página) -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- Descripción y Objetivos -->
        <div class="space-y-4">
          <h2 class="section-title border-b border-rule pb-2 mb-3">
            Descripción del Programa
          </h2>
          <p class="text-xs text-ink leading-relaxed whitespace-pre-line">
            {syllabus.program_description}
          </p>
        </div>

        <!-- Criterios de Evaluación -->
        <div class="space-y-6">
          <h2 class="section-title border-b border-rule pb-2 mb-3">
            Métodos de Evaluación y Calificación
          </h2>
          
          {isPartialsArray ? (
            criteriaData.map((partial: any) => {
              const partialKeys = Object.keys(partial.criteria || {});
              return (
                <div class="space-y-3 p-4 border border-rule bg-muted/10 rounded-sm">
                  <h3 class="text-xs font-mono uppercase tracking-wider text-primary font-bold">
                    {partial.partial_name}
                  </h3>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {partialKeys.map(key => {
                      const percentage = partial.criteria[key];
                      return (
                        <div class="p-3 border border-rule bg-muted/40 rounded-sm">
                          <span class="block text-xs font-bold text-ink">{key}</span>
                          <span class="block text-2xl font-black text-primary mt-1 font-mono">{percentage}</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })
          ) : (
            criteriaKeys.length > 0 ? (
              <div class="space-y-4">
                <p class="text-xs text-ink-2">
                  Los criterios oficiales establecidos por el docente para calificar el desempeño del alumno durante el período escolar son:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {criteriaKeys.map(key => {
                    const labelMap: any = {
                      exams: "Exámenes Teóricos",
                      project: "Proyecto Integrador",
                      assignments: "Tareas y Tareas Cortas",
                      practicalExams: "Exámenes Prácticos",
                      teamProject: "Proyecto en Equipo",
                      portfolio: "Portafolio de Evidencias",
                      quizzes: "Quizzes / Exámenes Rápidos",
                      finalProject: "Proyecto Final"
                    };
                    const label = labelMap[key] || key.charAt(0).toUpperCase() + key.slice(1);
                    const percentage = criteriaData[key];

                    return (
                      <div class="p-3 border border-rule bg-muted/40 rounded-sm">
                        <span class="block text-xs font-bold text-ink">{label}</span>
                        <span class="block text-2xl font-black text-primary mt-1 font-mono">{percentage}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            ) : (
              <p class="text-xs text-ink-2 italic">No se han definido criterios detallados.</p>
            )
          )}
        </div>

        <!-- Recursos y Bibliografía -->
        <div class="space-y-4">
          <h2 class="section-title border-b border-rule pb-2 mb-3">
            Recursos Didácticos y Bibliografía
          </h2>
          
          {resources.length > 0 ? (
            <ul class="space-y-3 pl-0 list-none">
              {resources.map(res => (
                <li class="p-3 border border-rule hover:border-ink-2 transition-colors duration-120 flex justify-between items-center gap-4 bg-transparent">
                  <div class="space-y-1">
                    <span class="block text-xs font-bold text-ink leading-tight">{res.title}</span>
                    {res.author && (
                      <span class="block text-[10px] text-ink-3 font-mono">Autor: {res.author}</span>
                    )}
                  </div>
                  {res.link && res.link !== "#" && (
                    <a
                      href={res.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-4 h-11 border border-rule text-[10px] font-mono font-bold text-ink hover:bg-muted transition-colors duration-120 no-underline flex items-center justify-center"
                    >
                      Enlace &nearrow;
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-xs text-ink-3 italic">No se ha registrado bibliografía para este programa.</p>
          )}
        </div>

      </div>

      <!-- Docente Titular (1/3 de la página) -->
      <div class="space-y-6">
        <div class="space-y-4">
          <h2 class="section-title border-b border-rule pb-2 mb-3">
            Docente Titular
          </h2>
          
          <div class="space-y-4">
            <div>
              <a 
                href={`/profesores/${syllabus.creator_slug}`} 
                class="font-bold text-primary hover:text-ink transition-colors duration-120 text-base block hover:underline"
              >
                {syllabus.creator_name}
              </a>
              <span class="block text-[10px] text-ink-3 mt-1 font-mono">{syllabus.creatorEmail || "Sin email registrado"}</span>
            </div>
            
            <hr class="rule" />
            
            <div class="space-y-3 text-xs">
              <div>
                <span class="field-label">Cubículo</span>
                <span class="field-value mt-0.5">{contactInfo.office || "No asignado"}</span>
              </div>
              <div>
                <span class="field-label">Teléfono de Oficina</span>
                <span class="field-value mt-0.5">{contactInfo.phone || "No asignado"}</span>
              </div>
              <div>
                <span class="field-label">Horario de Atención</span>
                <div class="bg-muted p-2 border border-rule font-sans mt-1 text-[11px] leading-relaxed text-ink-2">
                  {contactInfo.officeHours || "No especificado"}
                </div>
              </div>
            </div>

            <div class="pt-4">
              <a 
                href={`/profesores/${syllabus.creator_slug}`}
                class="btn btn--primary w-full text-center no-underline"
              >
                Ver Perfil de Investigador &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</InstitutionalLayout>

<style>
  .page-header {
    margin-bottom: 16px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: 3rem;
    }
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    letter-spacing: 0.06em;
    margin-top: 12px;
    line-height: 1.4;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
  }
</style>


---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import { cargarCarreras, cargarGrupoConProfesores, cargarHorarioDeGrupo, cargarExamenesDeGrupo, cargarSyllabusDeCarrera } from "../../lib/cargarDatos.js";

// Obtener el grupo activo
const student = Astro.locals.student;
const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";
const careers = await cargarCarreras();

let enrolledSubjects = [];
let activeGroup = null;

if (activeGroupSlug) {
  try {
    activeGroup = await cargarGrupoConProfesores(activeGroupSlug);
    if (activeGroup) {
      const schedules = await cargarHorarioDeGrupo(activeGroup.id);
      
      // Get unique subjects from schedules
      const uniqueSubjectsMap = new Map();
      for (const s of schedules) {
        if (!uniqueSubjectsMap.has(s.subject_name)) {
          uniqueSubjectsMap.set(s.subject_name, {
            subject_name: s.subject_name,
            professor_name: s.professor_name,
            professor_email: s.professor_email,
            professor_slug: s.professor_slug,
            professor_phone: s.professor_phone,
            professor_office: s.professor_office,
            professor_office_hours: s.professor_office_hours,
            professor_image: s.professor_image,
            classroom: s.classroom_name,
            is_lab: s.is_laboratory
          });
        }
      }
      const uniqueSubjects = Array.from(uniqueSubjectsMap.values());

      const syllabusList = await cargarSyllabusDeCarrera(activeGroup.career_id);
      const examDates = await cargarExamenesDeGrupo(activeGroup.id);

      // Combinar los datos
      enrolledSubjects = uniqueSubjects.map(sub => {
        const syllabus = syllabusList.find(s => s.subject_name?.toLowerCase().trim() === sub.subject_name?.toLowerCase().trim());
        const exams = examDates.filter(e => e.subject_name === sub.subject_name);
        
        return {
          ...sub,
          syllabusSlug: syllabus?.slug || "#",
          description: syllabus?.program_description || "Sin descripción disponible.",
          credits: syllabus?.credits || null,
          exams: exams
        };
      });
    }
  } catch (e) {
    console.error("Error al consultar materias matriculadas:", e);
  }
}
---

<InstitutionalLayout title="Mis Materias">

  <!-- Encabezado de sección asimétrico (Diseño Suizo) -->
  <div class="page-header">
    <div class="page-header__title">
      <span class="overline overline--primary">Panel Principal &mdash; Estudiante</span>
      <h1 class="page-title">Mis Materias</h1>
      {activeGroup && (
        <p class="page-subtitle">
          Materias matriculadas para {activeGroup.name} &mdash; {activeGroup.careerName}
        </p>
      )}
    </div>
  </div>

  <hr class="rule" style="margin-bottom: 40px;" />

  <!-- Grid de materias matriculadas -->
  {enrolledSubjects.length > 0 ? (
    <div class="subjects-grid">
      {enrolledSubjects.map(s => (
        <a
          href={s.syllabusSlug && s.syllabusSlug !== "#" ? `/materias/${s.syllabusSlug}${activeGroupSlug ? `?group=${activeGroupSlug}` : ''}` : "#"}
          class="subject-entry"
          style="text-decoration: none;"
          aria-label={`Ver detalles de ${s.subject_name}`}
        >
          <div style="flex: 1; display: flex; flex-direction: column; align-items: flex-start; text-align: left;">
            <div style="display: flex; justify-content: space-between; width: 100%; margin-bottom: 12px; align-items: flex-start;">
              <span class="overline" style="display: inline-block;">
                {activeGroup?.name || "Asignatura"}
              </span>
              {s.credits && (
                <span class="tag tag--primary">{s.credits} Créditos</span>
              )}
            </div>
            
            <h2 class="subject-entry__title">{s.subject_name}</h2>
            
            {s.professor_name && (
              <p class="subject-entry__professor">Docente: {s.professor_name}</p>
            )}
            
            <p class="subject-entry__desc">{s.description}</p>
          </div>
          
          <!-- Línea separadora inferior de la tarjeta tipográfica -->
          <div style="width: 100%; border-top: 1px solid var(--color-rule); margin-top: 20px; padding-top: 12px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-family: var(--font-mono); font-size: 0.625rem; color: var(--color-ink-3); text-transform: uppercase; letter-spacing: 0.04em;">
              {s.exams.length} Evaluaciones programadas
            </span>
            <span style="color: var(--color-secondary); font-size: 1.25rem; line-height: 1;">→</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin-bottom: 8px;">No se encontraron materias</h3>
      <p style="font-size: 0.875rem; color: var(--color-ink-2);">
        Al parecer no tienes materias matriculadas en este grupo, o ha ocurrido un error al cargar tus datos.
      </p>
    </div>
  )}



  <script type="module">
    // Propagación del grupo activo
    const saved = localStorage.getItem("pica_selected_group");
    const params = new URLSearchParams(window.location.search);
    if (!params.has("group") && saved) {
      window.location.href = `/materias?group=${saved}`;
    }
  </script>

</InstitutionalLayout>

<style>
  /* Page Header asimétrico */
  .page-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 32px;
    align-items: end;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .page-title { font-size: 3rem; }
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    letter-spacing: 0.06em;
    margin-top: 12px;
    line-height: 1.4;
  }

  /* Grid de asignaturas matriculadas */
  .subjects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .subjects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }
  
  @media (min-width: 1024px) {
    .subjects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Tarjeta de materia — Swiss Typography Edition
     Sin bordes de contenedor, solo un border-top para separar jerarquía. */
  .subject-entry {
    background: transparent;
    border: none;
    border-top: 2px solid var(--color-ink);
    padding: 20px 0 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: opacity 120ms;
    height: 100%;
  }

  .subject-entry:hover {
    opacity: 0.7;
  }

  .subject-entry:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  .subject-entry__title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-ink);
    margin-bottom: 8px;
  }

  .subject-entry__professor {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-2);
    margin-bottom: 12px;
  }

  .subject-entry__desc {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty-state {
    text-align: center;
    padding: 64px 24px;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Modal (Idéntico a index.astro para consistencia) */
  .modal-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 560px) {
    .modal-body {
      grid-template-columns: 1fr 1px 1fr;
    }
  }

  .modal-col {
    padding: 24px 28px;
  }

  .modal-divider {
    background-color: var(--color-rule);
    width: 1px;
  }

  @media (max-width: 559px) {
    .modal-divider { display: none; }
    .modal-col:first-child { border-bottom: 1px solid var(--color-rule); }
  }

  .modal-field {
    margin-bottom: 0;
  }
  
  .data-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
</style>

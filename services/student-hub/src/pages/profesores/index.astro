---
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import TeacherGrid from '../../components/TeacherGrid.astro';
import pool from '../../lib/db.js';
import { cargarDelegaciones, cargarFacultades } from '../../lib/cargarDatos.js';

const student = Astro.locals.student;
const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";

let profesores = [];
try {
  const pRes = await pool.query(`
    SELECT DISTINCT p.* 
    FROM professors p
    JOIN schedules s ON p.id = s.professor_id
    JOIN class_groups cg ON s.class_group_id = cg.id
    WHERE cg.slug = $1
    UNION
    SELECT p.*
    FROM professors p
    JOIN class_groups cg ON p.id = cg.tutor_id
    WHERE cg.slug = $1
  `, [activeGroupSlug]);
  
  profesores = pRes.rows.map(row => {
    let profile = row.profile_data;
    if (typeof profile === 'string') {
      try { profile = JSON.parse(profile); } catch(e) {}
    }
    profile = profile || {};
    profile.id = row.id;
    profile.slug = row.slug;
    profile.fullName = row.full_name;
    profile.email = row.email;
    profile.delegation_id = row.delegation_id;
    return profile;
  });
} catch(e) {
  console.error("Error loading teachers:", e);
}
const delegaciones = cargarDelegaciones();
const facultades = cargarFacultades();

const facultadesMap = facultades.map(f => ({
  id: f.id,
  delegation_id: f.delegation_id,
  name: f.name,
  career_ids: f.career_ids || []
}));
---

<InstitutionalLayout
  title="Profesores e Investigadores"
  description="Directorio formal y buscador de docentes investigadores de la Universidad de Colima."
>

  <!-- Encabezado -->
  <div style="margin-bottom: 24px;">
    <!-- Migas de pan -->
    <div style="
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-ink-3);
      margin-bottom: 16px;
    ">
      <a href="/" style="color: inherit; text-decoration: none; transition: color 150ms;"
        onmouseover="this.style.color='var(--color-primary)';"
        onmouseout="this.style.color='var(--color-ink-3)';
      >Inicio</a>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      <span style="color: var(--color-text-primary);">Profesores</span>
    </div>

    <div style="padding-bottom: 20px; border-bottom: 1px solid var(--color-border);">
      <span class="swiss-label swiss-label--primary" style="display: block; margin-bottom: 6px;">
        Directorio Docente
      </span>
      <h1 style="
        font-size: 1.875rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--color-text-primary);
      ">Profesores e Investigadores</h1>
      <p style="font-size: 0.8125rem; color: var(--color-text-secondary); margin-top: 6px; line-height: 1.5;">
        Busca perfiles académicos por nombre, asignatura, delegación o facultad.
      </p>
    </div>
  </div>

  <!-- Panel de búsqueda y filtros -->
  <div class="swiss-card" style="margin-bottom: 24px; display: flex; flex-direction: column; gap: 12px;">
    <!-- Buscador -->
    <div>
      <label for="search-input" class="swiss-label" style="display: block; margin-bottom: 6px;">
        Buscar docente
      </label>
      <div style="position: relative;">
        <div style="
          position: absolute;
          left: 12px;
          top: 50%;
          transform: translateY(-50%);
          color: var(--color-ink-3);
          pointer-events: none;
        ">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </div>
        <input
          type="text"
          id="search-input"
          placeholder="Nombre, cargo, departamento, materia..."
          style="
            width: 100%;
            height: 44px;
            padding: 0 12px 0 36px;
            background-color: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 2px;
            font-family: var(--font-sans);
            font-size: 0.875rem;
            color: var(--color-text-primary);
            outline: none;
            transition: border-color 150ms;
          "
          onfocus="this.style.borderColor='var(--color-secondary)';"
          onblur="this.style.borderColor='var(--color-border)';"
        />
      </div>
    </div>

    <!-- Filtros de delegación y facultad -->
    <div class="filters-grid">
      <div>
        <label for="delegation-filter" class="swiss-label" style="display: block; margin-bottom: 6px;">
          Delegación
        </label>
        <select id="delegation-filter" class="swiss-select">
          <option value="">Todas las delegaciones</option>
          {delegaciones.map(del => (
            <option value={del.id}>{del.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="faculty-filter" class="swiss-label" style="display: block; margin-bottom: 6px;">
          Facultad
        </label>
        <select id="faculty-filter" class="swiss-select">
          <option value="">Todas las facultades</option>
          {facultades.map(fac => (
            <option value={fac.id} data-delegation={fac.delegation_id}>{fac.name}</option>
          ))}
        </select>
      </div>
    </div>
  </div>

  <!-- Grid de profesores -->
  <div id="teachers-grid-wrapper">
    <TeacherGrid profesores={profesores} />
  </div>

  <!-- Sin resultados -->
  <div id="no-results-msg" class="hidden swiss-card" style="text-align: center; padding: 48px 24px;">
    <div style="
      width: 40px;
      height: 40px;
      margin: 0 auto 16px;
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-ink-3);
    ">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      </svg>
    </div>
    <h3 style="font-size: 0.875rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-primary); margin-bottom: 8px;">
      Sin coincidencias
    </h3>
    <p style="font-size: 0.8125rem; color: var(--color-text-secondary); max-width: 360px; margin: 0 auto; line-height: 1.5;">
      No se encontraron docentes que coincidan con los criterios. Intenta cambiar la búsqueda.
    </p>
  </div>

  <script type="application/json" id="facultades-map">
    {JSON.stringify(facultadesMap)}
  </script>

  <script>
    function setupSearch() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const delegationFilter = document.getElementById('delegation-filter') as HTMLSelectElement;
      const facultyFilter = document.getElementById('faculty-filter') as HTMLSelectElement;
      const teachersGridWrapper = document.getElementById('teachers-grid-wrapper');
      const noResultsMsg = document.getElementById('no-results-msg');

      if (!searchInput || !delegationFilter || !facultyFilter) return;

      let facultadesMap: Array<{ id: number; delegation_id: number; name: string; career_ids: number[] }> = [];
      try {
        const mapEl = document.getElementById('facultades-map');
        if (mapEl) facultadesMap = JSON.parse(mapEl.textContent || '[]');
      } catch(e) {}

      function updateFacultyOptions() {
        const selectedDelegation = delegationFilter.value;
        Array.from(facultyFilter.options).forEach(opt => {
          if (opt.value === '') return;
          const optDelegation = opt.getAttribute('data-delegation') || '';
          opt.hidden = selectedDelegation !== '' && optDelegation !== selectedDelegation;
        });
        const selectedOpt = facultyFilter.options[facultyFilter.selectedIndex];
        if (selectedOpt && selectedOpt.hidden) facultyFilter.value = '';
      }

      function performFilter() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedDelegation = delegationFilter.value;
        const selectedFaculty = facultyFilter.value;

        let selectedFacultyCareerIds: number[] = [];
        if (selectedFaculty !== '') {
          const fac = facultadesMap.find(f => f.id === parseInt(selectedFaculty, 10));
          if (fac) selectedFacultyCareerIds = fac.career_ids;
        }

        const cards = document.querySelectorAll('.teacher-card');
        let visibleCount = 0;

        cards.forEach((card: any) => {
          const cardText = card.textContent?.toLowerCase() || '';
          const cardDelegation = card.getAttribute('data-delegation') || '';
          const cardCareersRaw = card.getAttribute('data-careers') || '[]';
          const cardFaculty = card.getAttribute('data-faculty') || '';
          let cardCareers: number[] = [];
          try { cardCareers = JSON.parse(cardCareersRaw); } catch(e) {}

          const matchesQuery = query === '' || cardText.includes(query);
          const matchesDelegation = selectedDelegation === '' || cardDelegation === selectedDelegation;
          const matchesFaculty = selectedFaculty === '' ||
            cardFaculty === selectedFaculty ||
            selectedFacultyCareerIds.some(cid => cardCareers.includes(cid));

          if (matchesQuery && matchesDelegation && matchesFaculty) {
            card.classList.remove('hidden');
            card.style.display = '';
            visibleCount++;
          } else {
            card.classList.add('hidden');
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          teachersGridWrapper?.classList.add('hidden');
          noResultsMsg?.classList.remove('hidden');
        } else {
          teachersGridWrapper?.classList.remove('hidden');
          noResultsMsg?.classList.add('hidden');
        }
      }

      searchInput.addEventListener('input', performFilter);
      delegationFilter.addEventListener('change', () => { updateFacultyOptions(); performFilter(); });
      facultyFilter.addEventListener('change', performFilter);
      updateFacultyOptions();
      performFilter();
    }

    setupSearch();
    document.addEventListener('astro:page-load', setupSearch);
  </script>

</InstitutionalLayout>

<style>
  .filters-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .filters-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

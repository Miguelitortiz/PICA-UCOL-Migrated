---
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import TeacherGrid from '../../components/TeacherGrid.astro';
import { cargarDelegaciones, cargarFacultades } from '../../lib/cargarDatos.js';
import { fetchFromService } from '../../lib/api-client.js';
import { cargarProfesores } from '../../lib/cargarProfesores.js';

const student = Astro.locals.student;
const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";

let profesores = [];
try {
  const allProfs = await cargarProfesores();
  const groups = await fetchFromService('academic', '/groups');
  const group = groups.find(g => g.slug === activeGroupSlug);
  if (group) {
    const schedules = await fetchFromService('academic', '/schedules');
    const groupSchedules = schedules.filter(s => s.class_group_id === group.id);
    
    profesores = allProfs.filter(p => 
      p.id === group.tutor_id || groupSchedules.some(s => s.professor_id === p.id)
    );
  }
} catch(e) {
  console.error("Error loading teachers:", e);
}
const delegaciones = await cargarDelegaciones();
const facultades = await cargarFacultades();

const facultadesMap = facultades.map(f => ({
  id: f.id,
  delegation_id: f.delegation_id,
  name: f.name,
  career_ids: f.career_ids || []
}));
---

<InstitutionalLayout
  title="Profesores e Investigadores"
  description="Directorio de docentes e investigadores del grupo académico en la Universidad de Colima."
>

  <!-- Encabezado estándar -->
  <div class="page-header">
    <div class="page-header__title">
      <span class="overline overline--primary">Directorio Docente</span>
      <h1 class="page-title">Profesores</h1>
      <p class="page-subtitle">Docentes e investigadores asignados a tu grupo académico</p>
    </div>
  </div>

  <hr class="rule" style="margin-bottom: 40px;" />

  <!-- Grid de profesores -->
  <div id="teachers-grid-wrapper">
    <TeacherGrid profesores={profesores} />
  </div>

</InstitutionalLayout>

<style>
  .page-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 32px;
    align-items: end;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .page-title { font-size: 3rem; }
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    letter-spacing: 0.06em;
    margin-top: 12px;
    line-height: 1.4;
  }
</style>

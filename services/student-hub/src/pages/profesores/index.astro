---
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import TeacherGrid from '../../components/TeacherGrid.astro';
import pool from '../../lib/db.js';
import { cargarDelegaciones, cargarFacultades } from '../../lib/cargarDatos.js';

const student = Astro.locals.student;
const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";

let profesores = [];
try {
  const pRes = await pool.query(`
    SELECT DISTINCT p.* 
    FROM professors p
    JOIN schedules s ON p.id = s.professor_id
    JOIN class_groups cg ON s.class_group_id = cg.id
    WHERE cg.slug = $1
    UNION
    SELECT p.*
    FROM professors p
    JOIN class_groups cg ON p.id = cg.tutor_id
    WHERE cg.slug = $1
  `, [activeGroupSlug]);
  
  profesores = pRes.rows.map(row => {
    let profile = row.profile_data;
    if (typeof profile === 'string') {
      try { profile = JSON.parse(profile); } catch(e) {}
    }
    profile = profile || {};
    profile.id = row.id;
    profile.slug = row.slug;
    profile.fullName = row.full_name;
    profile.email = row.email;
    profile.delegation_id = row.delegation_id;
    return profile;
  });
} catch(e) {
  console.error("Error loading teachers:", e);
}
const delegaciones = cargarDelegaciones();
const facultades = cargarFacultades();

const facultadesMap = facultades.map(f => ({
  id: f.id,
  delegation_id: f.delegation_id,
  name: f.name,
  career_ids: f.career_ids || []
}));
---

<InstitutionalLayout
  title="Profesores e Investigadores"
  description="Directorio de docentes e investigadores del grupo académico en la Universidad de Colima."
>

  <!-- Encabezado estándar -->
  <div class="page-header">
    <div class="page-header__title">
      <span class="overline overline--primary">Directorio Docente</span>
      <h1 class="page-title">Profesores</h1>
      <p class="page-subtitle">Docentes e investigadores asignados a tu grupo académico</p>
    </div>
  </div>

  <hr class="rule" style="margin-bottom: 40px;" />

  <!-- Grid de profesores -->
  <div id="teachers-grid-wrapper">
    <TeacherGrid profesores={profesores} />
  </div>

</InstitutionalLayout>

<style>
  .page-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 32px;
    align-items: end;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .page-title { font-size: 3rem; }
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    letter-spacing: 0.06em;
    margin-top: 12px;
    line-height: 1.4;
  }
</style>

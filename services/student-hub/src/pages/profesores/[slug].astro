---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import IdentityCard from "../../components/IdentityCard.astro";
import PublicationList from "../../components/PublicationList.astro";
import TeachingList from "../../components/TeachingList.astro";
import ImpactSidebar from "../../components/ImpactSidebar.astro";
import HorizontalTimeline from "../../components/HorizontalTimeline.astro";
import { cargarProfesor } from "../../lib/cargarProfesores.js";

const { slug } = Astro.params;
const profesor = await cargarProfesor(slug);

if (!profesor) {
  return Astro.redirect('/404');
}

const {
  fullName,
  title,
  department,
  institutionalEmail,
  admissionYear,
  photoUrl,
  academicFormation,
  scientificProduction,
  educationalMaterials,
  teaching,
  certifications,
  academicBody,
} = profesor;
---

<InstitutionalLayout
  title={fullName}
  description={`Perfil académico de ${fullName}, ${title} del departamento de ${department}.`}
>
  <div class="max-w-5xl mx-auto space-y-4 lg:space-y-0 lg:grid lg:grid-cols-10 lg:gap-6 items-start">
    
    <!-- Columna Lateral Izquierda (Perfil + Indicadores): lg:col-span-3 -->
    <div class="accordion-item border border-border-sutil lg:border-none rounded-sm bg-white lg:bg-transparent lg:col-span-3 overflow-hidden">
      <!-- Encabezado Acordeón Móvil (Solo visible en móviles) -->
      <button class="accordion-header lg:hidden w-full flex justify-between items-center p-4 bg-bg-piedra/60 font-sans text-xs uppercase tracking-wider font-bold text-text-primary cursor-pointer">
        <span>Perfil e Indicadores</span>
        <span class="accordion-icon font-mono font-bold text-sm">−</span>
      </button>

      <!-- Contenido (Abierto por defecto en móvil, visible siempre en desktop) -->
      <div class="accordion-content p-4 lg:p-0 space-y-6 transition-all duration-200">
        <IdentityCard
          fullName={fullName}
          title={title}
          department={department}
          institutionalEmail={institutionalEmail}
          admissionYear={admissionYear}
          photoUrl={photoUrl}
        />

        <ImpactSidebar
          admissionYear={admissionYear}
          articles={scientificProduction.articles}
          theses={teaching.theses}
          academicBody={academicBody}
        />
      </div>
    </div>

    <!-- Columna Principal Derecha (Logros y Trayectoria): lg:col-span-7 -->
    <div class="accordion-item border border-border-sutil lg:border-none rounded-sm bg-white lg:bg-transparent lg:col-span-7 overflow-hidden">
      <!-- Encabezado Acordeón Móvil (Solo visible en móviles) -->
      <button class="accordion-header lg:hidden w-full flex justify-between items-center p-4 bg-bg-piedra/60 font-sans text-xs uppercase tracking-wider font-bold text-text-primary cursor-pointer">
        <span>Trayectoria y Logros</span>
        <span class="accordion-icon font-mono font-bold text-sm">+</span>
      </button>

      <!-- Contenido (Cerrado por defecto en móvil, visible siempre en desktop) -->
      <div class="accordion-content p-4 lg:p-0 hidden lg:block space-y-6">
        <!-- Línea de Tiempo Horizontal (Formación) -->
        <HorizontalTimeline academicFormation={academicFormation} />

        <!-- Pestañas (Tabs) con Altura Fija y Scroll Interno -->
        <div class="bg-white border border-border-sutil rounded-sm flex flex-col h-[622px]">
          <!-- Encabezado de Pestañas -->
          <div class="flex border-b border-border-sutil font-sans text-[10px] sm:text-xs uppercase tracking-wider font-bold bg-bg-piedra/40">
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-primary text-primary cursor-pointer transition-all duration-150" data-tab="publicaciones">
              Publicaciones
            </button>
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-all duration-150" data-tab="materias">
              Materias
            </button>
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-all duration-150" data-tab="tesis">
              Tesis
            </button>
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-text-secondary cursor-pointer transition-all duration-150" data-tab="recursos">
              Materiales y Cert.
            </button>
          </div>

          <!-- Contenedores de Paneles con Scroll Interno -->
          <div class="p-5 overflow-y-auto scrollbar-academic flex-1">
            <!-- Panel 1: Publicaciones -->
            <div class="tab-panel" id="panel-publicaciones">
              <PublicationList
                articles={scientificProduction.articles}
                books={scientificProduction.books}
              />
            </div>

            <!-- Panel 2: Materias -->
            <div class="tab-panel hidden" id="panel-materias">
              <TeachingList
                courses={teaching.courses}
                showOnly="courses"
              />
            </div>

            <!-- Panel 3: Tesis -->
            <div class="tab-panel hidden" id="panel-tesis">
              <TeachingList
                theses={teaching.theses}
                showOnly="theses"
              />
            </div>

            <!-- Panel 4: Recursos y Certificaciones -->
            <div class="tab-panel hidden" id="panel-recursos" class="space-y-6">
              <div class="space-y-6">
                <!-- Materiales Didácticos -->
                <div>
                  <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary mb-3 flex items-center">
                    <span class="text-primary mr-2">§</span> Recursos Didácticos
                  </h4>
                  {
                    educationalMaterials && educationalMaterials.length > 0 ? (
                      <ul class="list-none pl-0 text-xs font-sans">
                        {educationalMaterials.slice(0, 3).map((mat: any) => (
                          <li class="relative pl-6 mb-2 before:content-['■'] before:absolute before:left-0 before:text-primary before:text-[8px] before:top-[3px]">
                            <span class="font-medium text-text-primary">
                              {mat.title}
                            </span>
                            <span class="text-text-secondary uppercase text-[9px] tracking-wide ml-1 font-semibold">
                              ({mat.type})
                            </span>
                            {mat.url && (
                              <span class="ml-1.5">
                                <a
                                  href={mat.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="text-[10px] font-mono text-secondary hover:underline"
                                >
                                  → Enlace
                                </a>
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="text-xs italic text-text-secondary font-sans">
                        No se registran recursos didácticos.
                      </p>
                    )
                  }
                </div>

                <div class="divider-suizo"></div>

                <!-- Certificaciones -->
                <div>
                  <h4 class="font-sans text-xs uppercase tracking-widest font-semibold text-primary mb-3 flex items-center">
                    <span class="text-primary mr-2">§</span> Certificaciones Académicas
                  </h4>
                  {
                    certifications && certifications.length > 0 ? (
                      <ul class="list-none pl-0 text-xs font-sans">
                        {certifications.slice(0, 2).map((cert: any) => (
                          <li class="relative pl-6 mb-2 before:content-['■'] before:absolute before:left-0 before:text-primary before:text-[8px] before:top-[3px]">
                            <span class="font-medium text-text-primary">
                              {cert.title}
                            </span>
                            <span class="text-text-secondary font-semibold">
                              {" "}
                              &bull; {cert.institution}
                            </span>
                            <span class="font-mono text-[10px] text-text-secondary">
                              {" "}
                              ({cert.year})
                            </span>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="text-xs italic text-text-secondary/60 font-sans">
                        No se registran certificaciones.
                      </p>
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Script Vanilla JS para Interactividad -->
  <script>
    function setupTabs() {
      document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tabContainer = btn.closest(".accordion-content");
          if (!tabContainer) return;

          tabContainer.querySelectorAll(".tab-btn").forEach((b) => {
            b.classList.remove("text-primary", "border-b-primary");
            b.classList.add("border-transparent", "text-text-secondary");
          });

          btn.classList.add("text-primary", "border-b-primary");
          btn.classList.remove("border-transparent", "text-text-secondary");

          tabContainer.querySelectorAll(".tab-panel").forEach((panel) => {
            panel.classList.add("hidden");
          });

          const tabId = btn.getAttribute("data-tab");
          const targetPanel = tabContainer.querySelector(`#panel-${tabId}`);
          if (targetPanel) {
            targetPanel.classList.remove("hidden");
          }
        });
      });
    }

    function setupAccordions() {
      document.querySelectorAll(".accordion-header").forEach((header) => {
        header.addEventListener("click", () => {
          const item = header.closest(".accordion-item");
          if (!item) return;
          const content = item.querySelector(".accordion-content");
          const icon = item.querySelector(".accordion-icon");

          if (content && icon) {
            if (content.classList.contains("hidden")) {
              content.classList.remove("hidden");
              icon.textContent = "−";
            } else {
              content.classList.add("hidden");
              icon.textContent = "+";
            }
          }
        });
      });
    }

    function initAll() {
      setupTabs();
      setupAccordions();
    }

    initAll();
    document.addEventListener("astro:page-load", initAll);
  </script>
</InstitutionalLayout>

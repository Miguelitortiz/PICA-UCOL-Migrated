---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import IdentityCard from "../../components/IdentityCard.astro";
import PublicationList from "../../components/PublicationList.astro";
import TeachingList from "../../components/TeachingList.astro";
import ImpactSidebar from "../../components/ImpactSidebar.astro";
import HorizontalTimeline from "../../components/HorizontalTimeline.astro";
import { cargarProfesor } from "../../lib/cargarProfesores.js";

const { slug } = Astro.params;
const profesor = await cargarProfesor(slug);

if (!profesor) {
  return Astro.redirect('/404');
}

const {
  fullName,
  title,
  department,
  institutionalEmail,
  admissionYear,
  photoUrl,
  academicFormation,
  scientificProduction,
  educationalMaterials,
  teaching,
  certifications,
  academicBody,
  biography,
  showOnlyBiography
} = profesor;
---

<InstitutionalLayout
  title={fullName}
  description={`Perfil académico de ${fullName}, ${title} del departamento de ${department}.`}
>
  <div class="max-w-5xl mx-auto space-y-6 lg:space-y-0 lg:grid lg:grid-cols-10 lg:gap-6 items-start">
    
    <!-- Columna Lateral Izquierda (Perfil + Indicadores): lg:col-span-3 -->
    <div class="accordion-item border-b border-rule lg:border-none lg:col-span-3 bg-surface lg:bg-transparent">
      <!-- Encabezado Acordeón Móvil (Solo visible en móviles) -->
      <button class="accordion-header lg:hidden w-full flex justify-between items-center py-4 px-4 bg-muted font-sans text-xs uppercase tracking-wider font-bold text-ink cursor-pointer border-t border-rule">
        <span>Perfil e Indicadores</span>
        <span class="accordion-icon font-mono font-bold text-sm">−</span>
      </button>

      <!-- Contenido (Abierto por defecto en móvil, visible siempre en desktop) -->
      <div class="accordion-content p-4 lg:p-0 space-y-6 transition-all duration-200">
        <IdentityCard
          fullName={fullName}
          title={title}
          department={department}
          institutionalEmail={institutionalEmail}
          admissionYear={admissionYear}
          photoUrl={photoUrl}
        />

        <ImpactSidebar
          admissionYear={admissionYear}
          articles={scientificProduction?.articles || []}
          theses={teaching?.theses || []}
          academicBody={academicBody}
        />
      </div>
    </div>

    <!-- Columna Principal Derecha (Logros y Trayectoria): lg:col-span-7 -->
    <div class="accordion-item border-b border-rule lg:border-none lg:col-span-7 bg-surface lg:bg-transparent">
      <!-- Encabezado Acordeón Móvil (Solo visible en móviles) -->
      <button class="accordion-header lg:hidden w-full flex justify-between items-center py-4 px-4 bg-muted font-sans text-xs uppercase tracking-wider font-bold text-ink cursor-pointer border-t border-rule">
        <span>Trayectoria y Logros</span>
        <span class="accordion-icon font-mono font-bold text-sm">+</span>
      </button>

      <!-- Contenido (Cerrado por defecto en móvil, visible siempre en desktop) -->
      <div class="accordion-content p-4 lg:p-0 hidden lg:block space-y-6">
        {biography && (
          <div class="bg-surface border border-rule p-6 sm:p-8 rounded-sm prose prose-sm sm:prose-base max-w-none text-ink">
            <h2 class="font-bold text-xl sm:text-2xl text-primary mb-4 mt-0">Semblanza</h2>
            <p class="leading-relaxed whitespace-pre-wrap">{biography}</p>
          </div>
        )}

        {!showOnlyBiography && (
          <>
            <!-- Línea de Tiempo Horizontal (Formación) -->
            <HorizontalTimeline academicFormation={academicFormation} />

            <!-- Pestañas (Tabs) con Altura Fija y Scroll Interno -->
            <div class="bg-ground flex flex-col h-[622px]">
          <!-- Encabezado de Pestañas -->
          <div class="flex font-mono text-[10px] sm:text-xs uppercase tracking-wider font-bold bg-ground">
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-primary text-primary cursor-pointer transition-all duration-120" data-tab="publicaciones">
              Publicaciones
            </button>
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-ink-3 cursor-pointer transition-all duration-120" data-tab="materias">
              Materias
            </button>
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-ink-3 cursor-pointer transition-all duration-120" data-tab="tesis">
              Tesis
            </button>
            <button class="tab-btn px-4 h-11 flex items-center justify-center hover:text-primary border-b-2 border-transparent text-ink-3 cursor-pointer transition-all duration-120" data-tab="recursos">
              Materiales y Cert.
            </button>
          </div>

          <!-- Contenedores de Paneles con Scroll Interno -->
          <div class="py-6 px-0 overflow-y-auto scroll flex-1">
            <!-- Panel 1: Publicaciones -->
            <div class="tab-panel" id="panel-publicaciones">
              <PublicationList
                articles={scientificProduction?.articles || []}
                books={scientificProduction?.books || []}
              />
            </div>

            <!-- Panel 2: Materias -->
            <div class="tab-panel hidden" id="panel-materias">
              <TeachingList
                courses={teaching?.courses || []}
                showOnly="courses"
              />
            </div>

            <!-- Panel 3: Tesis -->
            <div class="tab-panel hidden" id="panel-tesis">
              <TeachingList
                theses={teaching?.theses || []}
                showOnly="theses"
              />
            </div>

            <!-- Panel 4: Recursos y Certificaciones -->
            <div class="tab-panel hidden space-y-6" id="panel-recursos">
              <div class="space-y-6">
                <!-- Materiales Didácticos -->
                <div>
                  <span class="overline overline--primary mb-4 block">Recursos Didácticos</span>
                  {
                    educationalMaterials && educationalMaterials.length > 0 ? (
                      <ul class="list-none pl-0 text-xs">
                        {educationalMaterials.slice(0, 3).map((mat: any) => (
                          <li class="relative pl-4 mb-2 before:content-['—'] before:absolute before:left-0 before:text-ink-3">
                            <span class="font-bold text-ink">
                              {mat.title}
                            </span>
                            <span class="text-ink-3 uppercase text-2xs tracking-wide ml-1 font-mono font-semibold">
                              ({mat.type})
                            </span>
                            {mat.url && (
                              <span class="ml-2">
                                <a
                                  href={mat.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="text-2xs font-mono text-primary hover:underline font-bold"
                                >
                                  → Enlace
                                </a>
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="text-xs italic text-ink-3">
                        No se registran recursos didácticos.
                      </p>
                    )
                  }
                </div>

                <hr class="rule" />

                <!-- Certificaciones -->
                <div>
                  <span class="overline overline--primary mb-4 block">Certificaciones Académicas</span>
                  {
                    certifications && certifications.length > 0 ? (
                      <ul class="list-none pl-0 text-xs">
                        {certifications.slice(0, 2).map((cert: any) => (
                          <li class="relative pl-4 mb-2 before:content-['—'] before:absolute before:left-0 before:text-ink-3">
                            <span class="font-bold text-ink">
                              {cert.title}
                            </span>
                            <span class="text-ink-2 font-mono text-2xs ml-1">
                              &bull; {cert.institution} ({cert.year})
                            </span>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="text-xs italic text-ink-3">
                        No se registran certificaciones.
                      </p>
                    )
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
        </>
        )}
      </div>
    </div>
  </div>

  <!-- Script Vanilla JS para Interactividad -->
  <script>
    function setupTabs() {
      document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const tabContainer = btn.closest(".accordion-content");
          if (!tabContainer) return;

          tabContainer.querySelectorAll(".tab-btn").forEach((b) => {
            b.classList.remove("text-primary", "border-primary");
            b.classList.add("border-transparent", "text-ink-3");
          });

          btn.classList.add("text-primary", "border-primary");
          btn.classList.remove("border-transparent", "text-ink-3");

          tabContainer.querySelectorAll(".tab-panel").forEach((panel) => {
            panel.classList.add("hidden");
          });

          const tabId = btn.getAttribute("data-tab");
          const targetPanel = tabContainer.querySelector(`#panel-${tabId}`);
          if (targetPanel) {
            targetPanel.classList.remove("hidden");
          }
        });
      });
    }

    function setupAccordions() {
      document.querySelectorAll(".accordion-header").forEach((header) => {
        header.addEventListener("click", () => {
          const item = header.closest(".accordion-item");
          if (!item) return;
          const content = item.querySelector(".accordion-content");
          const icon = item.querySelector(".accordion-icon");

          if (content && icon) {
            if (content.classList.contains("hidden")) {
              content.classList.remove("hidden");
              icon.textContent = "−";
            } else {
              content.classList.add("hidden");
              icon.textContent = "+";
            }
          }
        });
      });
    }

    function initAll() {
      setupTabs();
      setupAccordions();
    }

    initAll();
    document.addEventListener("astro:page-load", initAll);
  </script>
</InstitutionalLayout>

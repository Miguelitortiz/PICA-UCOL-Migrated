---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import { cargarGrupoConProfesores, cargarExamenesDeGrupo, cargarHorarioDeGrupo } from "../../lib/cargarDatos.js";

const student = Astro.locals.student;
const activeGroupSlug =
  student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";

const now = new Date();

let evaluationMonths: Array<{
  month: string;
  exams: Array<{
    id: number;
    subject: string;
    title: string;
    date: string;
    professor: string;
    classroom: string;
    type: string;
    status: string;
  }>;
}> = [];

let academicPeriod = "";
let examsRows = [];

try {
  const group = await cargarGrupoConProfesores(activeGroupSlug);
  if (group) {
    academicPeriod = group.academic_period || "";
    const exams = await cargarExamenesDeGrupo(group.id);
    const schedules = await cargarHorarioDeGrupo(group.id);

    examsRows = exams.map(ed => {
      const s = schedules.find(sched => sched.subject_name === ed.subject_name);
      return {
        id: ed.id,
        subject_name: ed.subject_name,
        exam_name: ed.exam_name,
        exam_date: ed.exam_date,
        exam_time: ed.exam_time,
        professor_name: s ? s.professor_name : "No asignado",
        classroom: s ? s.classroom_name : "Por asignar"
      };
    });
  }

  const monthMap = new Map<string, typeof evaluationMonths[0]["exams"]>();

  for (const row of examsRows) {
    const examDate = new Date(row.exam_date);
    const timeStr = row.exam_time ? row.exam_time.substring(0, 5) : "00:00";
    const [hh, mm] = timeStr.split(":").map(Number);
    examDate.setHours(hh, mm, 0, 0);

    const monthKey = examDate
      .toLocaleDateString("es-MX", { month: "long", year: "numeric" })
      .toUpperCase();

    const isPast = examDate < now;

    const exam = {
      id: row.id,
      subject: row.subject_name,
      title: row.exam_name,
      date: examDate.toISOString(),
      professor: row.professor_name || "Sin asignar",
      classroom: row.classroom || "—",
      type: "Evaluación",
      status: isPast ? "past" : "upcoming",
    };

    if (!monthMap.has(monthKey)) monthMap.set(monthKey, []);
    monthMap.get(monthKey)!.push(exam);
  }

  evaluationMonths = Array.from(monthMap.entries()).map(([month, exams]) => ({
    month,
    exams,
  }));
} catch (e) {
  console.error("Error cargando fechas de evaluación:", e);
}
---


<InstitutionalLayout title="Calendario de Evaluaciones">
  <div class="page-header">
    <div class="page-header__content">
      <span class="overline overline--primary">Calendario Académico</span>
      <h1 class="page-title">Fechas de Evaluación</h1>
      <p class="page-subtitle">Periodo: {academicPeriod || "Sem. en curso"}</p>
    </div>
  </div>

  <hr class="rule rule--thick" style="margin-bottom: 48px;" />

  <div class="evaluations-layout">
    <!-- Filtros Tipográficos -->
    <div class="filters">
      <span class="overline" style="margin-bottom: 16px; display: block;"
        >Vistas Rápidas</span
      >
      <ul class="filter-list">
        <li>
          <button class="filter-link active" data-view="cronologica"
            >Todos</button
          >
        </li>
        <li>
          <button class="filter-link" data-view="proximos"
            >Próximos Exámenes</button
          >
        </li>
        <li>
          <button class="filter-link" data-view="materia">Por Materia</button>
        </li>
      </ul>
    </div>

    <!-- Timeline Principal -->
    <div class="timeline-container">
      {
        evaluationMonths.map((group) => (
          <div class="month-group">
            <h2 class="month-title">{group.month}</h2>
            <hr class="rule" style="margin-bottom: 32px;" />

            <div class="timeline">
              {group.exams.map((ex) => {
                const d = new Date(ex.date);
                const dateStr = d
                  .toLocaleDateString("es-MX", {
                    day: "2-digit",
                    month: "short",
                  })
                  .toUpperCase();
                const timeStr = d.toLocaleTimeString("es-MX", {
                  hour: "2-digit",
                  minute: "2-digit",
                });
                const isPast = ex.status === "past";

                return (
                  <div
                    class={`timeline__item ${isPast ? "timeline__item--past" : ""}`}
                  >
                    <div class="timeline__date">
                      <span class="date-big">{dateStr.split(" ")[0]}</span>
                      <span class="date-month">{dateStr.split(" ")[1]}</span>
                      <span class="date-time">{timeStr}</span>
                    </div>

                    <div class="timeline__marker" />

                    <div class="timeline__body">
                      <span class="overline">{ex.subject}</span>
                      <h3 class="exam-title">{ex.title}</h3>

                      <div class="exam-meta-grid">
                        <div class="exam-meta-item">
                          <span class="meta-label">Modalidad</span>
                          <span class="meta-value">{ex.type}</span>
                        </div>
                        <div class="exam-meta-item">
                          <span class="meta-label">Titular</span>
                          <span class="meta-value">{ex.professor}</span>
                        </div>
                        <div class="exam-meta-item">
                          <span class="meta-label">Ubicación</span>
                          <span class="meta-value">{ex.classroom}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }

      {evaluationMonths.length === 0 && (
        <div style="padding: 48px 0; border-top: 1px solid var(--color-rule);">
          <span class="overline" style="display: block; margin-bottom: 8px;">Sin datos</span>
          <p style="font-size: 0.875rem; color: var(--color-ink-3);">No hay evaluaciones programadas para este grupo.</p>
        </div>
      )}
    </div>
  </div>

  <script>
    function setupViews() {
      const buttons = document.querySelectorAll(".filter-link[data-view]");
      const items = document.querySelectorAll(".timeline__item");
      const monthGroups = document.querySelectorAll(".month-group");

      function setActive(btn: Element) {
        buttons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
      }

      function showAll() {
        monthGroups.forEach((g) => ((g as HTMLElement).style.display = ""));
        items.forEach((item) => ((item as HTMLElement).style.display = ""));
      }

      function showOnlyUpcoming() {
        items.forEach((item) => {
          const isPast = item.classList.contains("timeline__item--past");
          (item as HTMLElement).style.display = isPast ? "none" : "";
        });
        // Ocultar grupos vacíos
        monthGroups.forEach((group) => {
          const visible = Array.from(
            group.querySelectorAll(".timeline__item"),
          ).some((item) => (item as HTMLElement).style.display !== "none");
          (group as HTMLElement).style.display = visible ? "" : "none";
        });
      }

      function groupBySubject() {
        // Reordenar mostrando items agrupados por subject (data-subject)
        // Como el HTML es estático, simulamos esto mostrando todos y
        // ordenándolos visualmente por la clase overline (subject)
        const container = document.querySelector(
          ".timeline-container",
        ) as HTMLElement;
        if (!container) return;

        // Recolectar todos los items
        const allItems = Array.from(
          document.querySelectorAll(".timeline__item"),
        ) as HTMLElement[];
        const subjects: Record<string, HTMLElement[]> = {};

        allItems.forEach((item) => {
          const subjectEl = item.querySelector(".overline");
          const subject = subjectEl?.textContent?.trim() || "Sin materia";
          if (!subjects[subject]) subjects[subject] = [];
          subjects[subject].push(item);
        });

        // Limpiar container y reconstruir agrupado
        container.innerHTML = "";
        Object.entries(subjects).forEach(([subject, examItems]) => {
          const group = document.createElement("div");
          group.className = "month-group";
          group.innerHTML = `<h2 class="month-title">${subject}</h2><hr class="rule" style="margin-bottom:32px;"/><div class="timeline"></div>`;
          const timeline = group.querySelector(".timeline") as HTMLElement;
          examItems.forEach((item) => {
            item.style.display = "";
            timeline.appendChild(item);
          });
          container.appendChild(group);
        });
      }

      // Guardar orden original para poder restaurarlo
      const originalHTML =
        document.querySelector(".timeline-container")?.innerHTML || "";

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          setActive(btn);
          const view = btn.getAttribute("data-view");

          if (view === "materia") {
            // Restaurar primero, luego agrupar
            const container = document.querySelector(
              ".timeline-container",
            ) as HTMLElement;
            if (container) container.innerHTML = originalHTML;
            groupBySubject();
          } else {
            // Restaurar HTML original antes de filtrar
            const container = document.querySelector(
              ".timeline-container",
            ) as HTMLElement;
            if (container) container.innerHTML = originalHTML;
            if (view === "proximos") showOnlyUpcoming();
            else showAll();
          }
        });
      });
    }

    setupViews();
    document.addEventListener("astro:page-load", setupViews);
  </script>
</InstitutionalLayout>

<style>
  /* Header Page */
  .page-header {
    margin-bottom: 24px;
  }
  .page-title {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    margin-top: 8px;
  }
  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
    margin-top: 12px;
  }

  /* Layout Evaluaciones */
  .evaluations-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-bottom: 80px;
  }
  @media (min-width: 1024px) {
    .evaluations-layout {
      grid-template-columns: 240px 1fr;
      gap: 80px;
    }
  }

  /* Filtros */
  .filter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .filter-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-2);
    text-decoration: none;
    transition: color 120ms;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    text-align: left;
  }
  .filter-link:hover {
    color: var(--color-ink);
  }
  .filter-link.active {
    color: var(--color-primary);
    font-weight: 800;
  }

  /* Timeline Agrupado */
  .month-group {
    margin-bottom: 64px;
  }
  .month-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin-bottom: 12px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 60px 24px 1fr;
    gap: 24px;
    padding-bottom: 48px;
  }
  @media (min-width: 640px) {
    .timeline__item {
      grid-template-columns: 80px 32px 1fr;
      gap: 32px;
    }
  }

  .timeline__date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 2px;
  }
  .date-big {
    font-size: 2rem;
    font-weight: 900;
    line-height: 0.9;
    color: var(--color-ink);
    letter-spacing: -0.04em;
  }
  .date-month {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-ink-2);
    margin-top: 4px;
    letter-spacing: 0.05em;
  }
  .date-time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    margin-top: 8px;
  }

  .timeline__marker {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background-color: var(--color-ink);
    position: relative;
    margin-top: 6px;
    margin-left: 6px;
    z-index: 2;
  }
  .timeline__marker::after {
    content: "";
    position: absolute;
    top: 13px;
    left: 6px;
    width: 1px;
    height: 300px;
    background-color: var(--color-rule-strong);
    z-index: 1;
  }
  .timeline__item:last-child .timeline__marker::after {
    display: none;
  }

  .timeline__item--past .timeline__marker {
    background-color: var(--color-rule-strong);
  }
  .timeline__item--past .date-big,
  .timeline__item--past .exam-title,
  .timeline__item--past .meta-value {
    color: var(--color-ink-2) !important;
  }

  .timeline__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .exam-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .exam-meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 16px;
    background-color: var(--color-muted);
    border-left: 2px solid var(--color-rule-strong);
  }
  @media (min-width: 640px) {
    .exam-meta-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .exam-meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--color-ink-3);
  }
  .meta-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
  }
</style>

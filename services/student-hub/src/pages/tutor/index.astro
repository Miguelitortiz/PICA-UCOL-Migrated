---
import InstitutionalLayout from "../../layouts/InstitutionalLayout.astro";
import pool from "../../lib/db.js";

const student = Astro.locals.student;
const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group") || "4-b-191";

let tutor = null;

try {
  const tRes = await pool.query(`
    SELECT p.full_name as name, 
           p.email as email,
           p.profile_data->>'title' as title,
           'Facultad de Telemática' as department,
           p.profile_data->'contactInfo'->>'office' as office,
           p.profile_data->'contactInfo'->>'officeHours' as hours,
           p.profile_data->>'image' as image
    FROM class_groups cg
    JOIN professors p ON cg.tutor_id = p.id
    WHERE cg.slug = $1
  `, [activeGroupSlug]);

  if (tRes.rows.length > 0) {
    tutor = tRes.rows[0];
  }
} catch (e) {
  console.error("Error cargando tutor:", e);
}

// Fallback en caso de que no tenga tutor asignado
if (!tutor) {
  tutor = {
    name: "Tutor No Asignado",
    title: "Docente",
    department: "Universidad de Colima",
    email: "contacto@ucol.mx",
    office: "Sin cubículo asignado",
    hours: "Previa Cita",
    image: "https://ui-avatars.com/api/?name=Tutor&background=F2F2F0&color=1A1A1A&size=600"
  };
}

const sessions = [
  {
    id: 1,
    date: "2026-10-15T12:30:00",
    topic: "Revisión de Avance Académico - Medio Término",
    status: "pending",
    modality: "Presencial"
  },
  {
    id: 2,
    date: "2026-08-20T13:00:00",
    topic: "Planificación de Carga Horaria",
    status: "completed",
    modality: "Virtual (Teams)",
    notes: "Se acordó mantener 6 materias para el semestre."
  },
  {
    id: 3,
    date: "2026-02-10T12:00:00",
    topic: "Primera Sesión de Contacto",
    status: "completed",
    modality: "Presencial",
    notes: "Identificación de objetivos a largo plazo."
  }
];
---

<InstitutionalLayout title="Mi Tutor Académico">

  <div class="page-header">
    <div class="page-header__content">
      <span class="overline overline--primary">Acompañamiento Estudiantil</span>
      <h1 class="page-title">Tutoría Académica</h1>
      <p class="page-subtitle">Programa Institucional de Tutorías (PIT)</p>
    </div>
  </div>

  <hr class="rule rule--thick" style="margin-bottom: 48px;" />

  <div class="tutor-layout">
    
    <!-- COLUMNA IZQUIERDA: Perfil del Tutor -->
    <div class="tutor-profile">
      <div class="tutor-profile__image-wrapper">
        <img src={tutor.image} alt={tutor.name} class="tutor-profile__image" />
      </div>
      
      <div class="tutor-profile__info">
        <h2 class="tutor-name">{tutor.name}</h2>
        <span class="tutor-title">{tutor.title}</span>
        
        <div class="metadata-list">
          <div class="metadata-item">
            <span class="metadata-label">Adscripción</span>
            <span class="metadata-value">{tutor.department}</span>
          </div>
          <div class="metadata-item">
            <span class="metadata-label">Ubicación Física</span>
            <span class="metadata-value">{tutor.office}</span>
          </div>
          <div class="metadata-item">
            <span class="metadata-label">Horario de Atención</span>
            <span class="metadata-value">{tutor.hours}</span>
          </div>
          <div class="metadata-item">
            <span class="metadata-label">Contacto Oficial</span>
            <a href={`mailto:${tutor.email}`} class="metadata-value link" style="font-family: var(--font-mono); font-size: 0.8125rem;">
              {tutor.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- COLUMNA DERECHA: Acciones y Bitácora -->
    <div class="tutor-actions">
      
      <!-- Panel de Acción Principal -->
      <div class="action-panel">
        <h3 style="font-size: 1.125rem; font-weight: 800; color: var(--color-ink); margin-bottom: 8px;">
          Gestión de Sesiones
        </h3>
        <p style="font-size: 0.875rem; color: var(--color-ink-2); line-height: 1.5; margin-bottom: 24px;">
          Solicita una cita con tu tutor para tratar temas académicos, administrativos o de orientación vocacional.
        </p>
        
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <button class="btn btn--primary">Solicitar Nueva Sesión</button>
          <button class="btn btn--outline">Enviar Mensaje Directo</button>
        </div>
      </div>

      <hr class="rule" style="margin: 32px 0;" />

      <!-- Bitácora de Sesiones -->
      <div class="sessions-log">
        <h3 style="font-size: 1.125rem; font-weight: 800; color: var(--color-ink); margin-bottom: 24px;">
          Bitácora de Encuentros
        </h3>

        <div style="display: flex; flex-direction: column; gap: 24px;">
          {sessions.map(session => {
            const d = new Date(session.date);
            const dateStr = d.toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" });
            const timeStr = d.toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit" });
            const isPending = session.status === "pending";

            return (
              <div class={`session-card ${!isPending ? 'session-card--past' : ''}`}>
                <div class="session-card__header">
                  <span class="session-card__date">{dateStr} &mdash; {timeStr}</span>
                  <span class={`tag ${isPending ? 'tag--primary' : 'tag--secondary'}`}>
                    {isPending ? 'Próxima' : 'Concluida'}
                  </span>
                </div>
                
                <h4 class="session-card__topic">{session.topic}</h4>
                <span class="session-card__meta">Modalidad: {session.modality}</span>
                
                {session.notes && (
                  <div class="session-card__notes">
                    <span style="font-weight: 700; display: block; margin-bottom: 4px;">Acuerdos / Notas:</span>
                    {session.notes}
                  </div>
                )}
              </div>
            )
          })}
        </div>
      </div>

    </div>
  </div>

</InstitutionalLayout>

<style>
  /* Header Page */
  .page-header {
    margin-bottom: 24px;
  }
  .page-title {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }
  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
    margin-top: 12px;
  }

  /* Layout Principal (1/2 o 2/3 asimétrico) */
  .tutor-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-bottom: 80px;
  }
  @media (min-width: 1024px) {
    .tutor-layout {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }

  /* Perfil del Tutor */
  .tutor-profile {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .tutor-profile__image-wrapper {
    width: 100%;
    aspect-ratio: 4/5;
    background-color: var(--color-muted);
    border: 1px solid var(--color-rule-strong);
    overflow: hidden;
  }
  .tutor-profile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
  }

  .tutor-name {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin-bottom: 8px;
  }
  .tutor-title {
    font-size: 1rem;
    color: var(--color-ink-2);
    display: block;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-rule);
  }

  /* Metadatos */
  .metadata-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .metadata-label {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--color-ink-3);
  }
  .metadata-value {
    font-size: 1rem;
    color: var(--color-ink);
  }

  /* Botones Base Suizos */
  .btn {
    display: block;
    width: 100%;
    padding: 16px;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 120ms ease;
    border: none;
  }
  .btn--primary {
    background-color: var(--color-ink);
    color: var(--color-surface);
  }
  .btn--primary:hover {
    background-color: var(--color-ink-2);
  }
  .btn--outline {
    background-color: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-rule-strong);
  }
  .btn--outline:hover {
    background-color: var(--color-ink);
    color: var(--color-surface);
  }

  /* Tarjetas de Bitácora */
  .session-card {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-rule);
  }
  .session-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .session-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .session-card__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-2);
  }
  
  .session-card__topic {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-ink);
    margin-bottom: 4px;
    line-height: 1.3;
  }
  .session-card__meta {
    font-size: 0.875rem;
    color: var(--color-ink-2);
    display: block;
  }
  .session-card__notes {
    margin-top: 12px;
    padding: 12px;
    background-color: var(--color-muted);
    border-left: 2px solid var(--color-rule-strong);
    font-size: 0.8125rem;
    color: var(--color-ink-2);
    line-height: 1.5;
  }

  .session-card--past .session-card__topic {
    color: var(--color-ink-2);
  }
</style>

    margin-top: 2px;
  }

  /* ══════════════════════════════════════════════════
     VISTA LISTA MÓVIL — agrupada por día
     Swiss Design: separación por regla + tipografía.
     ══════════════════════════════════════════════════ */
  .mobile-day {
    margin-bottom: 0;
  }

  .mobile-day__header {
    display: flex;

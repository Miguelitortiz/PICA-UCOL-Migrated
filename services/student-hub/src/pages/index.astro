---
import LoginPanel from "../components/LoginPanel.astro";
import InstitutionalLayout from "../layouts/InstitutionalLayout.astro";
import { cargarCarreras, cargarDelegaciones, cargarTodosLosGrupos, cargarGrupoConProfesores, cargarHorarioDeGrupo, cargarExamenesDeGrupo, cargarSyllabusDeCarrera } from "../lib/cargarDatos.js";

const student = Astro.locals.student;
const delegations = await cargarDelegaciones();
const allCareers = await cargarCarreras();
const fimeCareerIds = [349, 371, 418, 99];
const careers = allCareers.filter(c => fimeCareerIds.includes(c.id));
const allGroups = await cargarTodosLosGrupos();

const activeGroupSlug = student?.class_group_slug || Astro.url.searchParams.get("group");
let activeGroup = null;
let schedules = [];
let examDates = [];
let syllabusList = [];

if (activeGroupSlug) {
  activeGroup = await cargarGrupoConProfesores(activeGroupSlug);
  if (activeGroup) {
    schedules = await cargarHorarioDeGrupo(activeGroup.id);
    examDates = await cargarExamenesDeGrupo(activeGroup.id);
    syllabusList = await cargarSyllabusDeCarrera(activeGroup.career_id);
  }
}

const timeSlots = [
  { start: "07:00:00", end: "07:50:00", label: "07:00–07:50" },
  { start: "07:50:00", end: "08:40:00", label: "07:50–08:40" },
  { isRecess: true, start: "08:40:00", end: "09:10:00", label: "08:40–09:10", title: "Receso" },
  { start: "09:10:00", end: "10:00:00", label: "09:10–10:00" },
  { start: "10:00:00", end: "10:50:00", label: "10:00–10:50" },
  { start: "10:50:00", end: "11:40:00", label: "10:50–11:40" },
  { start: "11:40:00", end: "12:30:00", label: "11:40–12:30" },
  { start: "12:30:00", end: "13:20:00", label: "12:30–13:20" },
  { start: "13:20:00", end: "14:10:00", label: "13:20–14:10" },
  { start: "14:10:00", end: "15:00:00", label: "14:10–15:00" },
  { isRecess: true, start: "15:00:00", end: "15:30:00", label: "15:00–15:30", title: "Receso" },
  { start: "15:30:00", end: "16:20:00", label: "15:30–16:20" },
  { start: "16:20:00", end: "17:10:00", label: "16:20–17:10" },
  { start: "17:10:00", end: "18:00:00", label: "17:10–18:00" },
  { start: "18:00:00", end: "18:50:00", label: "18:00–18:50" },
  { start: "18:50:00", end: "19:40:00", label: "18:50–19:40" },
];

let minStartTime = "23:59:59";
let maxEndTime = "00:00:00";
if (schedules && schedules.length > 0) {
  schedules.forEach(s => {
    if (s.start_time < minStartTime) {
      minStartTime = s.start_time;
    }
    if (s.end_time > maxEndTime) {
      maxEndTime = s.end_time;
    }
  });
} else {
  minStartTime = "07:00:00";
  maxEndTime = "14:10:00";
}

const visibleTimeSlots = timeSlots.filter(slot => {
  return slot.start >= minStartTime && slot.start < maxEndTime;
});

const daysOfWeek = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes"];

function findScheduleItems(day: string, timeStart: string, timeEnd: string) {
  return schedules.filter(s => {
    if (s.day_of_week !== day) return false;
    return s.start_time < timeEnd && s.end_time > timeStart;
  });
}

const gridCells = [];
visibleTimeSlots.forEach((slot, slotIdx) => {
  gridCells[slotIdx] = [];
  daysOfWeek.forEach((day, dayIdx) => {
    gridCells[slotIdx][dayIdx] = { render: true, rowspan: 1, items: [] };
  });
});

daysOfWeek.forEach((day, dayIdx) => {
  for (let slotIdx = 0; slotIdx < visibleTimeSlots.length; slotIdx++) {
    const slot = visibleTimeSlots[slotIdx];
    if (slot.isRecess) continue;
    if (!gridCells[slotIdx][dayIdx].render) continue;

    const items = findScheduleItems(day, slot.start, slot.end);
    gridCells[slotIdx][dayIdx].items = items;

    if (slotIdx + 1 < visibleTimeSlots.length) {
      const nextSlot = visibleTimeSlots[slotIdx + 1];
      if (!nextSlot.isRecess) {
        const nextItems = findScheduleItems(day, nextSlot.start, nextSlot.end);
        if (items.length === 1 && nextItems.length === 1) {
          const item1 = items[0];
          const item2 = nextItems[0];
          if (item1.subject_name === item2.subject_name && item1.professor_id === item2.professor_id) {
            gridCells[slotIdx][dayIdx].rowspan = 2;
            gridCells[slotIdx + 1][dayIdx].render = false;
            item1.end_time = item2.end_time;
          }
        }
      }
    }
  }
});

function getSyllabusSlug(subjectName: string): string {
  const s = syllabusList.find(s =>
    s.subject_name?.toLowerCase().trim() === subjectName?.toLowerCase().trim()
  );
  return s?.slug || "#";
}

function getSyllabusDesc(subjectName: string): string {
  const s = syllabusList.find(s =>
    s.subject_name?.toLowerCase().trim() === subjectName?.toLowerCase().trim()
  );
  return s?.program_description || "Sin descripción disponible.";
}

function getDailySchedule(day: string) {
  return schedules
    .filter(s => s.day_of_week === day)
    .sort((a, b) => a.start_time.localeCompare(b.start_time))
    .map(item => ({
      ...item,
      isHti: item.is_hti || item.subject_name?.toUpperCase().includes('HTI')
    }));
}
---

{!student ? (
  <InstitutionalLayout title="Selección de Grupo">
    <div style="max-width: 800px; margin: 80px auto; padding: 0 24px; min-height: 400px;">
      
      <!-- Paso 1: Selecciona tu Carrera -->
      <div id="step-career" class="wizard-step">
        <span class="overline overline--primary">Paso 1 de 3</span>
        <h1 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; color: var(--color-ink); margin-top: 8px; line-height: 1.1; margin-bottom: 12px;">
          Selecciona tu Carrera
        </h1>
        <p style="font-size: 1rem; color: var(--color-ink-2); line-height: 1.5; margin-bottom: 36px;">
          Elige tu carrera académica para comenzar a visualizar tu horario.
        </p>

        <div style="display: grid; grid-template-columns: 1fr; gap: 12px;">
          {careers.map(career => (
            <button 
              class="career-btn" 
              data-id={career.id}
              data-name={career.name}
              style="text-align: left; padding: 20px; border: 1px solid var(--color-rule-strong); background: var(--color-surface); font-family: var(--font-sans); font-size: 1rem; font-weight: 700; color: var(--color-ink); cursor: pointer; transition: all 120ms;"
            >
              {career.name}
            </button>
          ))}
        </div>
      </div>

      <!-- Paso 2: Selecciona tu Semestre -->
      <div id="step-semester" class="wizard-step" style="display: none;">
        <span class="overline overline--primary">Paso 2 de 3</span>
        <h1 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; color: var(--color-ink); margin-top: 8px; line-height: 1.1; margin-bottom: 8px;">
          Selecciona tu Semestre
        </h1>
        <p id="selected-career-label" style="font-size: 1.125rem; font-weight: 700; color: var(--color-primary); margin-bottom: 36px;"></p>

        <div id="semesters-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-bottom: 40px;"></div>
        
        <button 
          id="btn-back-to-career" 
          style="padding: 10px 18px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: transparent; border: 1px solid var(--color-rule-strong); color: var(--color-ink); cursor: pointer; transition: all 150ms;"
        >
          ← Anterior
        </button>
      </div>

      <!-- Paso 3: Selecciona tu Grupo -->
      <div id="step-group" class="wizard-step" style="display: none;">
        <span class="overline overline--primary">Paso 3 de 3</span>
        <h1 style="font-size: 3rem; font-weight: 900; letter-spacing: -0.04em; color: var(--color-ink); margin-top: 8px; line-height: 1.1; margin-bottom: 8px;">
          Selecciona tu Grupo
        </h1>
        <p id="selected-career-sem-label" style="font-size: 1.125rem; font-weight: 700; color: var(--color-primary); margin-bottom: 36px;"></p>

        <div id="groups-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px; margin-bottom: 40px;"></div>
        
        <button 
          id="btn-back-to-semester" 
          style="padding: 10px 18px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: transparent; border: 1px solid var(--color-rule-strong); color: var(--color-ink); cursor: pointer; transition: all 150ms;"
        >
          ← Anterior
        </button>
      </div>

    </div>

    <script is:inline define:vars={{ allGroups }}>
      let selectedCareerId = null;
      let selectedCareerName = "";
      let selectedSemester = null;
      let selectedGroupSlug = null;

      const stepCareer = document.getElementById('step-career');
      const stepSemester = document.getElementById('step-semester');
      const stepGroup = document.getElementById('step-group');

      const careerBtns = document.querySelectorAll('.career-btn');
      const semestersGrid = document.getElementById('semesters-grid');
      const groupsGrid = document.getElementById('groups-grid');

      const selectedCareerLabel = document.getElementById('selected-career-label');
      const selectedCareerSemLabel = document.getElementById('selected-career-sem-label');

      const btnBackToCareer = document.getElementById('btn-back-to-career');
      const btnBackToSemester = document.getElementById('btn-back-to-semester');

      careerBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          selectedCareerId = parseInt(btn.getAttribute('data-id'), 10);
          selectedCareerName = btn.getAttribute('data-name');
          
          selectedSemester = null;
          selectedGroupSlug = null;

          selectedCareerLabel.textContent = selectedCareerName;

          const careerGroups = allGroups.filter(g => g.career_id === selectedCareerId);
          const semesters = [...new Set(careerGroups.map(g => g.semester))].sort((a, b) => a - b);

          semestersGrid.innerHTML = '';
          semesters.forEach(sem => {
            const semBtn = document.createElement('button');
            semBtn.style.padding = '18px';
            semBtn.style.border = '1px solid var(--color-rule-strong)';
            semBtn.style.backgroundColor = 'var(--color-surface)';
            semBtn.style.fontFamily = 'var(--font-sans)';
            semBtn.style.fontSize = '1.1rem';
            semBtn.style.fontWeight = '700';
            semBtn.style.color = 'var(--color-ink)';
            semBtn.style.cursor = 'pointer';
            semBtn.style.transition = 'all 120ms';
            semBtn.style.textAlign = 'center';
            semBtn.style.whiteSpace = 'nowrap';
            semBtn.className = 'sem-btn';
            semBtn.textContent = `${sem}° Semestre`;
            semBtn.addEventListener('click', () => {
              selectedSemester = sem;
              selectedCareerSemLabel.textContent = `${selectedCareerName} — Semestre ${selectedSemester}°`;

              const finalGroups = careerGroups.filter(g => g.semester === selectedSemester);
              groupsGrid.innerHTML = '';
              finalGroups.forEach(grp => {
                const grpBtn = document.createElement('button');
                grpBtn.style.padding = '18px';
                grpBtn.style.border = '1px solid var(--color-rule-strong)';
                grpBtn.style.backgroundColor = 'var(--color-surface)';
                grpBtn.style.fontFamily = 'var(--font-sans)';
                grpBtn.style.fontSize = '1.1rem';
                grpBtn.style.fontWeight = '700';
                grpBtn.style.color = 'var(--color-ink)';
                grpBtn.style.cursor = 'pointer';
                grpBtn.style.transition = 'all 120ms';
                grpBtn.style.textAlign = 'center';
                grpBtn.className = 'grp-btn';
                grpBtn.textContent = grp.name;
                grpBtn.addEventListener('click', () => {
                  selectedGroupSlug = grp.slug;
                  document.cookie = `pica_selected_group=${selectedGroupSlug}; path=/; max-age=${60 * 60 * 24 * 365}`;
                  window.location.href = '/';
                });

                grpBtn.addEventListener('mouseenter', () => {
                  grpBtn.style.borderColor = 'var(--color-ink)';
                  grpBtn.style.backgroundColor = 'var(--color-muted)';
                });
                grpBtn.addEventListener('mouseleave', () => {
                  grpBtn.style.borderColor = 'var(--color-rule-strong)';
                  grpBtn.style.backgroundColor = 'var(--color-surface)';
                });

                groupsGrid.appendChild(grpBtn);
              });

              stepSemester.style.display = 'none';
              stepGroup.style.display = 'block';
            });

            semBtn.addEventListener('mouseenter', () => {
              semBtn.style.borderColor = 'var(--color-ink)';
              semBtn.style.backgroundColor = 'var(--color-muted)';
            });
            semBtn.addEventListener('mouseleave', () => {
              semBtn.style.borderColor = 'var(--color-rule-strong)';
              semBtn.style.backgroundColor = 'var(--color-surface)';
            });

            semestersGrid.appendChild(semBtn);
          });

          stepCareer.style.display = 'none';
          stepSemester.style.display = 'block';
        });

        btn.addEventListener('mouseenter', () => {
          btn.style.borderColor = 'var(--color-ink)';
          btn.style.backgroundColor = 'var(--color-muted)';
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.borderColor = 'var(--color-rule-strong)';
          btn.style.backgroundColor = 'var(--color-surface)';
        });
      });

      btnBackToCareer.addEventListener('click', () => {
        stepSemester.style.display = 'none';
        stepCareer.style.display = 'block';
      });

      btnBackToSemester.addEventListener('click', () => {
        stepGroup.style.display = 'none';
        stepSemester.style.display = 'block';
      });
    </script>
  </InstitutionalLayout>
) : (
<InstitutionalLayout title="Horario del Estudiante">

  <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
    <div class="page-header__title">
      <span class="overline overline--primary">Panel Principal &mdash; Horario</span>
      <h1 class="page-title" style="margin-bottom: 8px;">
        Horario del<br />Estudiante
      </h1>
      {activeGroup && (
        <p class="page-subtitle">
          {activeGroup.name} &mdash; {activeGroup.careerName} &mdash; Turno {activeGroup.shift}
        </p>
      )}
    </div>
    
    <div style="margin-bottom: 8px;">
      <button id="btn-change-group" style="padding: 10px 18px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; background: transparent; border: 1px solid var(--color-rule-strong); color: var(--color-ink); cursor: pointer; transition: all 150ms;">
        Cambiar de Grupo
      </button>
    </div>
  </div>

  <script is:inline>
    document.getElementById('btn-change-group')?.addEventListener('click', () => {
      document.cookie = "pica_selected_group=; path=/; max-age=0;";
      window.location.href = "/";
    });
  </script>


  <hr class="rule" style="margin-bottom: 40px;" />

  <!-- ═══════════════════════════════════════════════════
       CONTENIDO PRINCIPAL
       Grid asimétrico: horario (amplio) + sidebar (estrecho)
       ═══════════════════════════════════════════════════ -->
  <div class="content-grid">

    <!-- ─────────────────────────────────────
         SIDEBAR INFORMATIVO
         Sin tarjetas, sin bordes contenedores.
         Secciones separadas por regla + whitespace.
         ───────────────────────────────────── -->
    <aside class="sidebar" aria-label="Información del grupo">

      <!-- Información del grupo -->
      {activeGroup && (
        <div class="sidebar-section">
          <span class="overline">Tu grupo</span>
          <div class="sidebar-data">
            <div class="data-row">
              <span class="field-label">Grupo</span>
              <span class="field-value">{activeGroup.name}</span>
            </div>
            <div class="data-row">
              <span class="field-label">Carrera</span>
              <span class="field-value">{activeGroup.careerName}</span>
            </div>
            <div class="data-row">
              <span class="field-label">Turno</span>
              <span class="field-value">{activeGroup.shift}</span>
            </div>
            {activeGroup.semester && (
              <div class="data-row">
                <span class="field-label">Semestre</span>
                <span class="field-value">{activeGroup.semester}°</span>
              </div>
            )}
          </div>
        </div>
      )}

      <!-- Tutor del grupo -->
      {activeGroup?.tutor_name && (
        <>
          <hr class="rule" />
          <div class="sidebar-section">
            <span class="overline">Tutor</span>
            <div class="sidebar-data">
              <div class="data-row">
                <span class="field-label">Docente</span>
                <a href={`/profesores/${activeGroup.tutor_slug}`} class="field-value link">
                  {activeGroup.tutor_name}
                </a>
              </div>
              {activeGroup.tutor_email && (
                <div class="data-row">
                  <span class="field-label">Email</span>
                  <a href={`mailto:${activeGroup.tutor_email}`} class="field-value link" style="font-size: 0.75rem; font-weight: 500;">
                    {activeGroup.tutor_email}
                  </a>
                </div>
              )}
              {activeGroup.tutor_office && (
                <div class="data-row">
                  <span class="field-label">Cubículo</span>
                  <span class="field-value">{activeGroup.tutor_office}</span>
                </div>
              )}
            </div>
          </div>
        </>
      )}



    </aside>

    <!-- ─────────────────────────────────────
         COLUMNA PRINCIPAL: TABLA DE HORARIO
         Swiss table: solo reglas horizontales.
         Sin bordes de celda. Sin fondos alternados.
         La tipografía diferencia, no el color.
         ───────────────────────────────────── -->
    <section aria-label="Horario semanal" class="schedule-section">
      <div class="section-head">
        <span class="overline">Horario semanal</span>
      </div>

      <!-- ── VISTA TABLA (Desktop) ── -->
      <div class="schedule-desktop" role="region" aria-label="Tabla de horario, desplazable horizontalmente" tabindex="0">
        <table class="schedule-table" role="grid" aria-label="Horario semanal de clases">
          <thead>
            <tr>
              <th scope="col" class="schedule-table__time-header">Hora</th>
              {daysOfWeek.map(day => (
                <th scope="col" class="schedule-table__day-header">{day}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {visibleTimeSlots.map((slot, slotIdx) => {
              if (slot.isRecess) {
                return (
                  <tr class="schedule-table__row recess-row" style="background: rgba(var(--color-primary-rgb), 0.04); font-weight: bold; border-top: 1px solid var(--color-rule-strong); border-bottom: 1px solid var(--color-rule-strong);">
                    <td class="schedule-table__time-cell" style="height: 38px; padding: 8px 16px 8px 0; vertical-align: middle;">
                      <span class="time-label" style="padding-top: 0;">{slot.label}</span>
                    </td>
                    <td colspan="5" class="schedule-table__cell recess-cell" style="height: 38px; text-align: center; color: var(--color-primary); letter-spacing: 0.15em; text-transform: uppercase; font-size: 0.72rem; padding: 0; font-family: var(--font-sans); font-weight: 800; background: var(--color-surface-2); vertical-align: middle;">
                      Receso
                    </td>
                  </tr>
                );
              }

              return (
                <tr class="schedule-table__row">
                  <td class="schedule-table__time-cell">
                    <span class="time-label">{slot.label}</span>
                  </td>
                  {daysOfWeek.map((day, dayIdx) => {
                    const cell = gridCells[slotIdx][dayIdx];
                    if (!cell.render) return null;

                    return (
                      <td class="schedule-table__cell" rowspan={cell.rowspan} style={cell.rowspan > 1 ? "vertical-align: middle;" : ""}>
                         <div style={`display: flex; flex-direction: column; gap: 4px; height: 100%; ${cell.rowspan > 1 ? 'justify-content: center;' : ''}`}>
                          {cell.items.map(item => {
                          const syllabusSlug = item ? getSyllabusSlug(item.subject_name) : "#";
                          const syllabusDesc = item ? getSyllabusDesc(item.subject_name) : "";
                          const isHtiEntry = item.is_hti || (item.subject_name && item.subject_name.toUpperCase().includes('HTI'));
                          return (
                            <button
                              class={`class-entry class-card-btn ${isHtiEntry ? 'independent-work' : ''}`}
                              style={cell.rowspan > 1 ? "min-height: 95px; display: flex; flex-direction: column; justify-content: center;" : ""}
                              aria-label={`${item.subject_name}${isHtiEntry ? ' (HTI)' : ''}, ${item.professor_name}`}
                              data-subject={item.subject_name}
                              data-professor={item.professor_name}
                              data-professor-email={item.professor_email}
                              data-professor-slug={item.professor_slug}
                              data-professor-phone={item.professor_phone || ""}
                              data-professor-office={item.professor_office || ""}
                              data-professor-hours={item.professor_office_hours || ""}
                              data-professor-image={item.professor_image || ""}
                              data-classroom={item.classroom_name || ""}
                              data-is-lab={item.is_lab ? "Sí" : "No"}
                              data-syllabus-slug={syllabusSlug}
                              data-description={syllabusDesc}
                              data-exams={JSON.stringify(examDates.filter(e => e.subject_name === item.subject_name))}
                            >
                              <span class="class-entry__subject">{item.subject_name}</span>
                              <span class="class-entry__time" style="font-size: 0.65rem; opacity: 0.8; display: block; font-family: monospace;">{item.start_time.substring(0, 5)} - {item.end_time.substring(0, 5)}</span>
                              {item.professor_name && (
                                <span class="class-entry__professor">{item.professor_name}</span>
                              )}
                              {item.classroom_name && (
                                <span class="class-entry__room">
                                  {item.classroom_name}
                                  {item.is_lab && <span class="class-entry__lab-tag">LAB</span>}
                                </span>
                              )}
                              {isHtiEntry && (
                                <span class="class-entry__hti-tag">HTI</span>
                              )}
                            </button>
                          );
                        })}
                        </div>
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- ── VISTA LISTA (Móvil) ── -->
      <div class="schedule-mobile" aria-label="Horario semanal por día">
        {daysOfWeek.map(day => {
          const dayItems = getDailySchedule(day);
          return (
            <div class="mobile-day">
              <div class="mobile-day__header">
                <span class="mobile-day__name">{day}</span>
                <span class="mobile-day__count">{dayItems.length} {dayItems.length === 1 ? 'clase' : 'clases'}</span>
              </div>
              {dayItems.length === 0 ? (
                <div class="mobile-day__empty">
                  <span>Sin clases programadas</span>
                </div>
              ) : (
                <div class="mobile-day__list">
                  {dayItems.map(item => {
                    const syllabusSlug = getSyllabusSlug(item.subject_name);
                    const syllabusDesc = getSyllabusDesc(item.subject_name);
                    const isHtiEntry = item.isHti || item.subject_name?.toUpperCase().includes('HTI');
                    return (
                      <button
                        class={`mobile-class class-card-btn ${isHtiEntry ? 'independent-work' : ''}`}
                        aria-label={`${item.subject_name}${isHtiEntry ? ' (HTI)' : ''}, ${item.professor_name}`}
                        data-subject={item.subject_name}
                        data-professor={item.professor_name}
                        data-professor-email={item.professor_email}
                        data-professor-slug={item.professor_slug}
                        data-professor-phone={item.professor_phone || ""}
                        data-professor-office={item.professor_office || ""}
                        data-professor-hours={item.professor_office_hours || ""}
                        data-professor-image={item.professor_image || ""}
                        data-classroom={item.classroom_name || ""}
                        data-is-lab={item.is_lab ? "Sí" : "No"}
                        data-syllabus-slug={syllabusSlug}
                        data-description={syllabusDesc}
                        data-exams={JSON.stringify(examDates.filter(e => e.subject_name === item.subject_name))}
                      >
                        <span class="mobile-class__time">{item.start_time.substring(0, 5)} – {item.end_time.substring(0, 5)}</span>
                        <div class="mobile-class__info">
                          <span class="mobile-class__subject">{item.subject_name}</span>
                          {item.professor_name && (
                            <span class="mobile-class__professor">{item.professor_name}</span>
                          )}
                          <span class="mobile-class__meta">
                            {item.classroom_name || ''}
                            {item.is_lab && <span class="class-entry__lab-tag">LAB</span>}
                            {isHtiEntry && <span class="class-entry__hti-tag">HTI</span>}
                          </span>
                        </div>
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </div>

  <!-- ═══════════════════════════════════════════════════
       MODAL DE CLASE
       Swiss: sin decoración. Solo información organizada
       con tipografía y espaciado. Una línea de división.
       ═══════════════════════════════════════════════════ -->
  <div
    id="class-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-subject-name"
    style="
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(26,26,26,0.6);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 24px;
    "
  >
    <div
      id="modal-panel"
      style="
        background: var(--color-surface);
        width: 100%;
        max-width: 680px;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
      "
    >
      <!-- Banda de color superior del modal -->
      <div style="height: 3px; background-color: var(--color-secondary);"></div>

      <!-- Header del modal -->
      <div style="
        padding: 24px 28px 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
      ">
        <div>
          <span class="overline overline--secondary">Detalle de clase</span>
          <h2
            id="modal-subject-name"
            style="
              font-size: 1.5rem;
              font-weight: 800;
              letter-spacing: -0.03em;
              color: var(--color-ink);
              margin-top: 4px;
              line-height: 1.15;
            "
          ></h2>
          <a
            id="modal-professor-link"
            href="#"
            class="link"
            style="
              font-size: 0.8125rem;
              font-weight: 500;
              margin-top: 4px;
              display: inline-block;
            "
          ></a>
        </div>
        <button
          id="btn-close-modal"
          aria-label="Cerrar detalle"
          style="
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--color-ink-3);
            cursor: pointer;
            padding: 0 4px;
            line-height: 1;
            flex-shrink: 0;
          "
        >×</button>
      </div>

      <hr class="rule" />

      <!-- Cuerpo del modal -->
      <div class="modal-body">

        <!-- Columna izquierda: descripción y exámenes -->
        <div class="modal-col">
          <div class="modal-field">
            <span class="field-label">Descripción de la materia</span>
            <p
              id="modal-subject-desc"
              style="
                font-size: 0.8125rem;
                color: var(--color-ink-2);
                line-height: 1.6;
                margin-top: 4px;
              "
            ></p>
          </div>

          <hr class="rule" style="margin: 16px 0;" />

          <div class="modal-field">
            <span class="field-label">Evaluaciones programadas</span>
            <div id="modal-exams-container" style="margin-top: 8px;"></div>
          </div>

          <div style="margin-top: 20px;">
            <a
              id="modal-syllabus-btn"
              href="#"
              class="btn btn--primary"
              style="display: none; text-decoration: none; width: 100%;"
            >Ver programa completo</a>
          </div>
        </div>

        <!-- Divisor vertical -->
        <div class="modal-divider"></div>

        <!-- Columna derecha: aula y docente -->
        <div class="modal-col">
          <div class="modal-field">
            <span class="field-label">Aula / Espacio</span>
            <div style="
              margin-top: 6px;
              display: flex;
              align-items: baseline;
              justify-content: space-between;
              gap: 8px;
            ">
              <span
                id="modal-classroom"
                style="
                  font-family: var(--font-mono);
                  font-size: 1.25rem;
                  font-weight: 700;
                  color: var(--color-ink);
                "
              ></span>
              <span id="modal-lab-type" style="font-size: 0.75rem; color: var(--color-ink-3);"></span>
            </div>
            <a
              id="modal-map-link"
              href="#"
              class="link"
              style="font-size: 0.75rem; margin-top: 4px; display: inline-block;"
            >Ver en mapa</a>
          </div>

          <hr class="rule" style="margin: 16px 0;" />

          <div class="modal-field">
            <span class="field-label">Docente responsable</span>
            <div style="display: flex; gap: 16px; margin-top: 8px; align-items: flex-start;">
              <!-- Foto del docente -->
              <div style="width: 64px; height: 64px; border: 1px solid var(--color-rule-strong); overflow: hidden; flex-shrink: 0;">
                <img id="modal-prof-img" src="" alt="Foto del docente" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%) contrast(1.1); display: none;" />
                <div id="modal-prof-img-placeholder" style="width: 100%; height: 100%; background: var(--color-muted); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: var(--color-ink-3);">
                  👨‍🏫
                </div>
              </div>
              <div style="display: flex; flex-direction: column; gap: 6px; flex: 1;">
                <div class="data-row">
                  <span class="field-label">Email</span>
                  <span id="modal-prof-email" style="font-size: 0.8125rem; color: var(--color-ink-2);"></span>
                </div>
                <div class="data-row">
                  <span class="field-label">Teléfono</span>
                  <span id="modal-prof-phone" style="font-size: 0.8125rem; color: var(--color-ink-2);"></span>
                </div>
                <div class="data-row">
                  <span class="field-label">Cubículo</span>
                  <span id="modal-prof-office" style="font-size: 0.8125rem; color: var(--color-ink-2);"></span>
                </div>
                <div class="data-row">
                  <span class="field-label">Horario de atención</span>
                  <span id="modal-prof-hours" style="font-size: 0.8125rem; color: var(--color-ink-2);"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    // ── Modal ──
    const modal    = document.getElementById("class-modal");
    const btnClose = document.getElementById("btn-close-modal");

    const mSubject   = document.getElementById("modal-subject-name");
    const mProfLink  = document.getElementById("modal-professor-link");
    const mDesc      = document.getElementById("modal-subject-desc");
    const mClassroom = document.getElementById("modal-classroom");
    const mLabType   = document.getElementById("modal-lab-type");
    const mEmail     = document.getElementById("modal-prof-email");
    const mPhone     = document.getElementById("modal-prof-phone");
    const mOffice    = document.getElementById("modal-prof-office");
    const mHours     = document.getElementById("modal-prof-hours");
    const mImg       = document.getElementById("modal-prof-img");
    const mImgPl     = document.getElementById("modal-prof-img-placeholder");
    const mSyllabus  = document.getElementById("modal-syllabus-btn");
    const mExams     = document.getElementById("modal-exams-container");
    const mMapLink   = document.getElementById("modal-map-link");

    document.querySelectorAll(".class-card-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const subject    = btn.getAttribute("data-subject") || "";
        const professor  = btn.getAttribute("data-professor") || "";
        const profEmail  = btn.getAttribute("data-professor-email") || "";
        const profSlug   = btn.getAttribute("data-professor-slug") || "";
        const profPhone  = btn.getAttribute("data-professor-phone") || "";
        const profOffice = btn.getAttribute("data-professor-office") || "";
        const profHours  = btn.getAttribute("data-professor-hours") || "";
        const profImage  = btn.getAttribute("data-professor-image") || "";
        const classroom  = btn.getAttribute("data-classroom") || "";
        const isLab      = btn.getAttribute("data-is-lab") === "Sí";
        const sylSlug    = btn.getAttribute("data-syllabus-slug") || "";
        const desc       = btn.getAttribute("data-description") || "Sin descripción disponible.";
        const exams      = JSON.parse(btn.getAttribute("data-exams") || "[]");

        if (mSubject)   mSubject.textContent   = subject;
        if (mProfLink)  { mProfLink.textContent = professor; mProfLink.href = profSlug ? `/profesores/${profSlug}` : "#"; }
        if (mDesc)      mDesc.textContent      = desc;
        if (mClassroom) mClassroom.textContent  = classroom;
        if (mLabType)   mLabType.textContent    = isLab ? "Laboratorio" : "Aula teórica";
        if (mEmail)     mEmail.textContent      = profEmail || "—";
        if (mPhone)     mPhone.textContent      = profPhone || "—";
        if (mOffice)    mOffice.textContent     = profOffice || "—";
        if (mHours)     mHours.textContent      = profHours || "—";
        if (mMapLink)   mMapLink.href           = `/mapa?highlight=${encodeURIComponent(classroom)}`;
        
        if (mImg && mImgPl) {
          if (profImage) {
            mImg.src = profImage;
            mImg.style.display = "block";
            mImgPl.style.display = "none";
          } else {
            mImg.style.display = "none";
            mImgPl.style.display = "flex";
          }
        }

        if (mSyllabus) {
          if (sylSlug && sylSlug !== "#") {
            mSyllabus.href = `/materias/${sylSlug}`;
            mSyllabus.style.display = "flex";
          } else {
            mSyllabus.style.display = "none";
          }
        }

        if (mExams) {
          mExams.innerHTML = "";
          if (exams && exams.length > 0) {
            exams.forEach(ex => {
              const d = new Date(ex.exam_date);
              const dateStr = d.toLocaleDateString("es-MX", { day: "numeric", month: "long", year: "numeric" });
              const row = document.createElement("div");
              row.style.cssText = "display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid var(--color-rule);";
              row.innerHTML = `
                <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-ink);">${ex.exam_name}</span>
                <span style="font-size:0.75rem; font-family:var(--font-mono); color:var(--color-ink-3);">${dateStr} · ${ex.exam_time?.substring(0,5)}</span>
              `;
              mExams.appendChild(row);
            });
          } else {
            mExams.innerHTML = `<p style="font-size:0.75rem; color:var(--color-ink-3); padding-top:4px;">Sin exámenes programados.</p>`;
          }
        }

        if (modal) {
          modal.style.display = "flex";
          document.body.style.overflow = "hidden";
        }
      });
    });

    function closeModal() {
      if (modal) { modal.style.display = "none"; document.body.style.overflow = ""; }
    }

    btnClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", e => { if (e.target === modal) closeModal(); });
    document.addEventListener("keydown", e => { if (e.key === "Escape") closeModal(); });
  </script>

  </InstitutionalLayout>
)}

<style>
  /* ══════════════════════════════════════════════════
     PAGE HEADER — asimétrico, tipografía dominante
     ══════════════════════════════════════════════════ */
  .page-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 32px;
    align-items: end;
  }

  @media (min-width: 768px) {
    .page-header {
      grid-template-columns: 2fr 1fr;
      gap: 48px;
    }
  }

  .page-title {
    font-size: 2.5rem;       /* 40px — presencia editorial */
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: var(--color-ink);
    margin-top: 8px;
  }

  @media (min-width: 768px) {
    .page-title { font-size: 3rem; }    /* 48px en desktop */
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-3);
    letter-spacing: 0.06em;
    margin-top: 12px;
    line-height: 1.4;
  }

  .page-header__selector {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* ══════════════════════════════════════════════════
     CONTENT GRID — 2 columnas asimétrico
     ══════════════════════════════════════════════════ */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .content-grid {
      grid-template-columns: 260px 1fr;
      gap: 56px;
    }
  }

  /* ══════════════════════════════════════════════════
     RESPONSIVE: Desktop table vs Mobile list
     ══════════════════════════════════════════════════ */
  .schedule-desktop {
    display: none;
    overflow-x: auto;
  }

  .schedule-mobile {
    display: block;
  }

  @media (min-width: 768px) {
    .schedule-desktop { display: block; }
    .schedule-mobile { display: none; }
  }

  /* ══════════════════════════════════════════════════
     TABLA DE HORARIO — Swiss style (Desktop)
     Solo reglas horizontales. Sin bordes de celda.
     Sin fondos alternados. Tipografía como jerarquía.
     ══════════════════════════════════════════════════ */
  .section-head {
    margin-bottom: 16px;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 520px;
  }

  /* Línea fuerte bajo el header de la tabla */
  .schedule-table thead tr {
    border-bottom: 2px solid var(--color-ink);
  }

  .schedule-table__time-header,
  .schedule-table__day-header {
    font-family: var(--font-mono);
    font-size: 0.5625rem;       /* 9px */
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    text-align: left;
    padding: 0 12px 12px 0;
    white-space: nowrap;
  }

  .schedule-table__time-header {
    width: 96px;
    padding-right: 16px;
  }

  /* Filas separadas solo por línea horizontal delgada */
  .schedule-table__row {
    border-bottom: 1px solid var(--color-rule);
    transition: background-color 80ms;
  }

  .schedule-table__row:last-child {
    border-bottom: none;
  }

  .schedule-table__row:hover {
    background-color: var(--color-muted);
  }

  .schedule-table__time-cell {
    padding: 16px 16px 16px 0;
    vertical-align: top;
  }

  .time-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--color-ink-3);
    letter-spacing: 0.04em;
    white-space: nowrap;
    display: block;
    padding-top: 2px;
  }

  .schedule-table__cell {
    padding: 12px 12px 12px 0;
    vertical-align: top;
    min-width: 100px;
    height: 96px;
    box-sizing: border-box;
  }

  /* Entrada de clase — botón sin estilos de botón */
  .class-entry {
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    border-left: 2px solid transparent;
    padding-left: 8px;
    transition: border-color 120ms;
  }

  .class-entry:hover {
    border-left-color: var(--color-secondary);
  }

  .class-entry:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .class-entry__subject {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink);
